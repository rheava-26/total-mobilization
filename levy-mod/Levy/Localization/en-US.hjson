			}

			MilitiaDeathMessageMode: {
				Tooltip: ""

				Count: {
					Label: Count
					Tooltip: ""
				}

				Individual: {
					Label: Individual
					Tooltip: ""
				}

				None: {
					Label: None
					Tooltip: ""
				}
			}
		}

