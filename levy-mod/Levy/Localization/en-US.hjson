# Levy — every player-facing string except soldier dialogue (Dialogue/en-US.txt).
# Style: 1-4 short declarative sentences. What it is, reach, the numbers that matter, one special rule.
Mods: {
	Levy: {
		Items: {
			BarracksItem: {
				DisplayName: Barracks
				Tooltip:
					'''
					The hub of a settlement. Town NPCs living within 120 tiles belong to it.
					Right-click it to enlist Regulars, pay wages and raise the militia.
					'''
			}

			ArmoryItem: {
				DisplayName: Armory
				Tooltip:
					'''
					A 1000-slot store with issue rows for weapons, armor, ammo and potions.
					Soldiers of a Barracks within 120 tiles arm themselves from it.
					'''
			}

			LogisticalCenterItem: {
				DisplayName: Logistical Center
				Tooltip:
					'''
					Adds 250 storage slots to the nearest Armory within 40 tiles.
					Centers stack.
					'''
			}

			PatrolBannerItem: {
				DisplayName: Patrol Banner
				Tooltip: Place two to mark a patrol line. Assign Regulars to it from the Barracks.
			}

			WarHorn: {
				DisplayName: War Horn
				Tooltip:
					'''
					Left-click to call up or stand down the nearest settlement's militia.
					Right-click to give orders to your Regulars.
					'''
			}

			CommandRadio: {
				DisplayName: Command Radio
				Tooltip:
					'''
					A field set tuned to every soldier you command.
					Carry it to give orders from the radial to your whole army, anywhere. Click it to open the radial.
					Shift-click the full map to send every levy to that point.
					'''
			}

			GoProItem: {
				DisplayName: GoPro
				Tooltip:
					'''
					A body camera. A levy who carries it can be watched.
					Use it to see through the next GoPro levy. Right-click or Esc to stop.
					'''
			}

			StaticCameraItem: {
				DisplayName: Static Camera
				Tooltip:
					'''
					Place it, then right-click it from anywhere in reach to see its view.
					Mouse wheel zooms out to a wide arena view.
					'''
			}

			MindLinkItem: {
				DisplayName: Mind Link
				Tooltip:
					'''
					Use it to take direct control of the levy nearest your cursor. Your movement and attack drive that levy.
					Right-click to let go. Dying gives you a levy to control until you respawn.
					'''
			}

			FieldManual: {
				DisplayName: Field Manual
				Tooltip:
					'''
					A plain-language guide to raising a militia and an army.
					Right-click to read it. It stays in your pack; read it whenever.
					'''
			}

			GuideToConscription: {
				DisplayName: A Guide to Conscription
				Tooltip: Each town NPC provides 15 manpower instead of 9. Manpower is the reserve the militia draw from as they fall, not how many stand at once. Consumed on use, once per world.
			}

			GuideToDrill: {
				DisplayName: A Guide to Drill
				Tooltip: Militia aim 25% better. Consumed on use, once per world.
			}

			GuideToPlunder: {
				DisplayName: A Guide to Plunder
				Tooltip: Coins hauled to the treasury are worth 50% more. Consumed on use, once per world.
			}

			GuideToFortification: {
				DisplayName: A Guide to Fortification
				Tooltip: Soldiers within 60 tiles of a Barracks gain 4 defense. Consumed on use, once per world.
			}

			GuideToDiscipline: {
				DisplayName: A Guide to Discipline
				Tooltip: Your soldiers aim truer. Shots are 35% tighter. Consumed on use, once per world.
			}

			GuideToFirepower: {
				DisplayName: A Guide to Firepower
				Tooltip:
					'''
					Militia gain 100 health and 80 mana.
					Every Armory gains 2 buff slots.
					Dropped by the Wall of Flesh. Consumed on use, once per world.
					'''
			}

			GuideToHealthcare: {
				DisplayName: A Guide to Healthcare
				Tooltip: Militia gain 150 health. Consumed on use, once per world.
			}

			GuideToTheArcaneArts: {
				DisplayName: A Guide to the Arcane Arts
				Tooltip: Militia gain 60 mana. Consumed on use, once per world.
			}

			GuideToExpertise: {
				DisplayName: A Guide to Expertise
				Tooltip:
					'''
					Every soldier gains 1 accessory slot.
					Dropped by the Lunatic Cultist. Consumed on use, once per world.
					'''
			}

			GuideToEngineering: {
				DisplayName: A Guide to Engineering
				Tooltip:
					'''
					Unlocks combat drones at every Barracks. Needs the Mechanization mod.
					A drone mounts one spare ranged or magic weapon from the Armory and fires it at nearby enemies.
					A destroyed drone returns its weapon. Consumed on use, once per world.
					'''
			}

			LevyRod: {
				DisplayName: Levy Rod
				Tooltip: Plants a levy sentry during the Old One's Army. Calls up {0} levy for {1} Etherian Mana.
			}

			LevyCane: {
				DisplayName: Levy Cane
				Tooltip: Plants a levy sentry during the Old One's Army. Calls up {0} levies for {1} Etherian Mana.
			}

			LevyStaff: {
				DisplayName: Levy Staff
				Tooltip: Plants a levy sentry during the Old One's Army. Calls up {0} levies for {1} Etherian Mana.
			}

			BarracksAle: {
				DisplayName: Barracks Ale
				Tooltip: Your levies within {0} tiles gain defense for {1} minutes. They aim worse while drunk.
			}

			BlackStout: {
				DisplayName: Black Stout
				Tooltip: Your levies within {0} tiles deal more damage for {1} minutes. They aim worse while drunk.
			}

			SpicedRum: {
				DisplayName: Spiced Rum
				Tooltip: Your levies within {0} tiles attack faster for {1} minutes. They aim worse while drunk.
			}
		}

