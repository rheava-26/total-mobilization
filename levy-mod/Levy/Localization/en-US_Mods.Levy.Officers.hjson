# Officer strings (town NPCs conscripted into the army). Keys are relative to Mods.Levy.Officers.
Tag: Officer {0}
TagOffDuty: Officer {0} (off duty, unpaid)

Fail: {
	Invalid: That cannot be commissioned.
	NoDef: This townsperson cannot serve as an officer.
	AlreadyOfficer: Already an officer.
	NoSlot: Every command slot is filled. Dismiss an officer first.
	NotHoused: Only townsfolk housed in this settlement or one linked by pylon can be commissioned from this Barracks.
	TooFar: No Barracks of the network or active pylon within range.
	NoMoney: No treasury or stored coin in this settlement can cover the commission fee.
}

Msg: {
	Commissioned: "{0}, your {1}, is now an officer. Commission fee: {2}."
	Dismissed: "{0} is dismissed and returns to town life."
	Lapsed: "{0} leaves the army. The commission has lapsed."
	Fallen: "{0} has fallen."
	Unpaid: "{0} was not paid at dawn: no treasury or stored coin anywhere in the settlement covers the wage. Missed paydays: {1} of {2}, then the officer goes off duty."
	OffDuty: "{0} is off duty: no treasury or stored coin anywhere in the settlement could cover the wage. The commission is kept. Duty resumes at the first dawn the wage is paid."
	Resumed: "{0} is back on duty."
	Payday: Officers paid: {0}.
}

UI: {
	Open: Officers {0}/{1}
	OpenHint: Conscript townsfolk as officers. They leave their post, march with the army and bring a special skill.
	Title: Officers - {0}
	Sub: Command slots {0}/{1}. The fee is paid once; the wage comes from the settlement's treasuries and stored coin at dawn.
	SlotEmpty: Slot {0}: empty
	SlotLine: "{0}. {1}, {2}"
	Unpaid: " (unpaid {0} day)"
	Dismiss: Dismiss
	DismissHint: Sends {0} back to town life. The fee is not refunded.
	Commission: Commission
	CommissionHint: Costs {0} now and {1} a day.
	Cost: Fee {0}. Wage {1} a day.
	Available: Townsfolk who can serve
	NoneAvailable: No one housed in this settlement or its pylon-linked towns can serve as an officer yet.
	TownHeader: "{0} (pylon-linked)"
	PylonTownHeader: "{0} town (pylon-linked)"
	Hint: Officers fight beside the army. If one falls they are gone until rehoused.
	SlotsHeader: Command slots
	SlotRole: Slot {0}: {1}
	SlotWage: Wage {0} a day
	SlotEmptyHint: No officer assigned. Commission a townsperson below.
	UnpaidWarn: Unpaid for {0} day. Missed paydays mean off duty.
	OffDuty: Off duty. Back at the first dawn the treasury can pay.
	CandidateHead: "{0} - {1}"
	ResizeHint: Drag to resize the officer list.
}

Kit: {
	Nurse: {
		Name: Nurse
		Desc: Heals the most wounded soldier within {0} tiles back to full. Each soldier can be healed once every {1} seconds. Each heal is paid from the treasury, up to {2}. Throws syringes at enemies in reach but never leaves the army to chase.
	}

	Guide: {
		Name: Guide
		Desc: Soldiers within {0} tiles aim {1}% more accurately. Every {2} seconds he calls a volley and nearby soldiers fire together. Shoots enemies in reach with a wooden bow.
	}

	Angler: {
		Name: Angler
		Desc: Soldiers and officers within {0} tiles stay Well Fed. Throws frost daggerfish at enemies in reach.
	}

	Pirate: {
		Name: Pirate Captain
		Desc: Brings {0} flintlock gunners with {1} health and {3} cannon with {4} health that march with the army. A lost gunner is replaced after {2} seconds and a cannon after {5}. Their damage grows as bosses fall. Fires a flintlock pistol at enemies in reach.
	}

	Princess: {
		Name: Princess
		Desc: Soldiers and officers within {0} tiles get Morale: {1}% more damage, {2} defense and {3}% critical chance. Strikes enemies in reach with her wand.
	}

	Dryad: {
		Name: Dryad
		Desc: Enemies within {0} tiles are marked with Dryad's Bane and take {1}% more damage from the army. Soldiers within {2} tiles get Dryad's Blessing: {3} defense, life regeneration and {4}% of contact damage reflected. Shoots seeds at enemies in reach.
	}

	GoblinTinkerer: {
		Name: Goblin Tinkerer
		Desc: Every {1} seconds he reforges the weapon of one soldier within {0} tiles, up to {2} rolls, aiming for the top {3}% of its modifiers. Each roll costs the normal reforge price from the treasury. He always leaves {4} soldier wages in it. Throws spiky balls at enemies in reach.
	}

	TaxCollector: {
		Name: Tax Collector
		Desc: Marks enemies within {0} tiles so the army hits them harder. A marked enemy that dies near him pays a bounty into the treasury, up to {1}.
	}

	Demolitionist: {
		Name: Demolitionist
		Desc: Throws grenades at enemies in reach. Every {0} seconds he throws dynamite for a heavy blast that grows stronger as bosses fall. Nearby soldiers throw his grenades too.
	}

	ArmsDealer: {
		Name: Arms Dealer
		Desc: Soldiers within {0} tiles aim {1}% more accurately and use no ammo. Fires a Minishark at enemies in reach.
	}

	Merchant: {
		Name: Merchant
		Desc: Enemies that die within {0} tiles of him add {1}% of their coin value to the treasury. Hands basic ammo and potions to soldiers within {2} tiles, paid from the treasury. While he serves, his shop pays {3}% more and charges {4}% less. Throws knives at enemies in reach.
	}

	Painter: {
		Name: Painter
		Desc: Enemies hit with paint lose {0} defense and deal {1}% less damage. Fires a paintball gun at enemies in reach.
	}

	Clothier: {
		Name: Clothier
		Desc: Raises up to {0} skeletons that fight beside the army, from Skeletons early on to Hell Armored Bones late. In a fight a fallen skeleton rises again after {1} s; one that deals no damage for {2} seconds crumbles. Throws cursed skulls at enemies in reach.
	}

	Wizard: {
		Name: Wizard
		Desc: Enchants {0} flying swords that hover over the army and slash the nearest enemy. Each has {1} health and is replaced {2} seconds after it breaks; their damage grows as bosses fall. Casts diamond bolts at enemies in reach.
	}

	Zoologist: {
		Name: Zoologist
		Desc: Calls the strongest Bestiary creature the world's progress allows, never a boss or miniboss. It fights with its own attacks and is replaced {0} seconds after it falls. Fires a green bolt at enemies in reach.
	}

	Cyborg: {
		Name: Cyborg
		Desc: Deploys {0} combat drones that fire lasers from above the army. Each has {1} health and is rebuilt {2} seconds after it falls; their damage grows as bosses fall. Ore and treasure glow around his commander. Fires rockets at enemies in reach.
	}

	WitchDoctor: {
		Name: Witch Doctor
		Desc: Soldiers, summons and officers within {0} tiles poison {1}% of their hits: {3} damage a second for {2} seconds, ignoring defense. Calls {4} voodoo spirits with {5} health that spit poison darts; a lost one returns after {6} seconds. Venom damage grows as bosses fall. Fires a blowgun at enemies in reach.
	}
}
