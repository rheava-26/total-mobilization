def fnum(x):
    try: return float(x)
    except (TypeError, ValueError): return None

def med(xs): return statistics.median(xs) if xs else None
def f0(x, d=0): return "-" if x is None else f"{x:.{d}f}"

def fisher(w1, n1, w2, n2):
    """two-sided Fisher exact p for wins w1/n1 vs w2/n2."""
    k = w1 + w2; N = n1 + n2
    if N == 0: return 1.0
    pr = lambda a: math.comb(n1, a) * math.comb(n2, k - a) / math.comb(N, k)
    p0 = pr(w1)
    return min(1.0, sum(pr(a) for a in range(max(0, k - n2), min(n1, k) + 1) if pr(a) <= p0 + 1e-12))

def points(cp, n, sumhp, rank):
    return n * (cp.get("per_levy", 0) + cp.get("pot_per_levy", 0)) + sumhp / 100.0 * cp.get("per_100hp", 0) + rank / 1000.0 * cp.get("per_rank_1000", 0) + cp.get("flat", 0)

def cmd_table(a):
    rd = Path(a.run_dir); meta = json.loads((rd / "cells.json").read_text()); rows = read_tsv_csv(rd / "results.csv")
    by = {}
    for r in rows: by.setdefault(r["cell"], []).append(r)
    extra = (a.cols or "").split(",") if a.cols else []
    hdr = ["cell", "levies", "pts", "wins", "kill s (med)", "levy deaths", "1st death s", "boss left", "taken head/body/proj %", "dealt R/M/E/S %"] + extra
    out = []; base = None
    for c in meta["cells"]:
        rs = by.get(c["id"], []); fin = [r for r in rs if r["result"] not in ("MISSING", "ERROR")]
        n = len(rs); wins = [r for r in fin if r["result"] == "WIN"]
        if base is None: base = (len(wins), n)
        ks = [fnum(r["sec"]) for r in wins]
        n_lev = [fnum(r.get("n")) or 0 for r in fin]
        dths = [fnum(r["deaths"]) or 0 for r in fin]
        fd = [fnum(r["firstDeathSec"]) for r in fin if fnum(r.get("firstDeathSec")) is not None]
        left = [fnum(r["bossLeft"]) for r in fin if r["result"] != "WIN" and fnum(r["bossLeft"]) is not None]
        mx = [fnum(r["bossMax"]) for r in fin if r["result"] != "WIN" and fnum(r["bossMax"])]
        tk = [sum(fnum(r.get(k)) or 0 for k in ("takenHead", "takenBody", "takenTail", "takenProj", "takenOtherContact")) for r in fin]
        th, tb, tp = (sum(fnum(r.get(k)) or 0 for r in fin) for k in ("takenHead", "takenBody", "takenProj"))
        tt = sum(tk) or 1
        dm = [sum(fnum(r.get(k)) or 0 for r in fin) for k in ("dmgR", "dmgM", "dmgE", "dmgS")]; dtot = sum(dm) or 1
        pts = [points(c.get("cost") or {}, fnum(r.get("n")) or 0, (fnum(r.get("n")) or 0) * (fnum(r.get("avgHp")) or 0), fnum(r.get("rankSum")) or 0) for r in fin if r.get("n")]
        nl = statistics.mean(n_lev) if n_lev else None
        lev = f"{nl:.0f} x {c.get('hp', '')}hp" if nl and c.get("hp") else (f0(nl) if nl else "-")
        wcell = f"**{len(wins)}/{n}**" + (f" ({len(rs) - len(fin)} bad)" if len(rs) - len(fin) else "")
        if base and c is not meta["cells"][0] and n: wcell += f" p={fisher(len(wins), n, *base):.2f}"
        row = [c["name"], lev, f0(statistics.mean(pts)) if pts else "-", wcell,
               (f"{med(ks):.0f} ({min(ks):.0f}-{max(ks):.0f})" if ks else "-"),
               f"{statistics.mean(dths):.1f}/{nl:.0f}" if nl and dths else "-", f0(med(fd), 0) if fd else "none",
               (f"{statistics.mean(left) / 1000:.1f}k ({100 * statistics.mean(left) / (statistics.mean(mx) or 1):.0f}%)" if left and mx else "-"),
               f"{100 * th / tt:.0f}/{100 * tb / tt:.0f}/{100 * tp / tt:.0f}", "/".join(f"{100 * x / dtot:.0f}" for x in dm)]
        for e in extra:
            v = [fnum(r.get(e)) for r in fin if fnum(r.get(e)) is not None]
            row.append(f"{statistics.mean(v):.1f}" if v else "-")
        out.append(row)
    print("| " + " | ".join(hdr) + " |"); print("|" + "---|" * len(hdr))
    for r in out: print("| " + " | ".join(r) + " |")
    if a.wide:
        print("\nTop weapons by boss damage (summed over seeds):")
        for c in meta["cells"]:
            tot = {}
            for r in by.get(c["id"], []):
                for tok in (r.get("weaponDmg") or "").split():
                    k, _, v = tok.rpartition("=")
                    if v.isdigit(): tot[k] = tot.get(k, 0) + int(v)
            print(f"- {c['name']}: " + ", ".join(f"{k} {v}" for k, v in sorted(tot.items(), key=lambda kv: -kv[1])[:5]))
    notes = [f"{meta.get('fights', '?')} fights in {meta.get('wall_s', '?')}s ({meta.get('fights_per_min', '?')}/min, {meta.get('processes', '?')} server processes), build {meta.get('build')}, run dir {rd}"]
    if meta.get("missing_items"): notes.append("MISSING ITEM NAMES (dropped by the harness): " + ", ".join(meta["missing_items"]))
    errs = [r for r in rows if r["result"] in ("MISSING", "ERROR")]
    if errs: notes.append(f"{len(errs)} fights did not finish (MISSING/ERROR rows in results.csv; logs in jobs/*/try*/)")
    print("\n" + "\n".join(notes))
    print("pts = army points (levies + HP + WeaponRank + potions + stations; weights in the presets' cost: blocks). Columns: taken = damage received by head/body/projectile; dealt = ranged/magic/melee/summon share.")

