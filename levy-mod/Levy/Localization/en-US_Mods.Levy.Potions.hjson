# Spectator and Seeker potions, the Guide to Autonomy and their buffs. Keys are relative to Mods.Levy.Potions.
SpectatorPotion: {
	DisplayName: Spectator Potion
	Tooltip: Enemies ignore you, but you cannot fight or build. Has no effect against a boss you have not beaten.
}

SeekerPotion: {
	DisplayName: Seeker Potion
	Tooltip: Choose one item. Tiles and chests that hold it glow.
}

GuideToAutonomy: {
	DisplayName: A Guide to Autonomy
	Tooltip:
		'''
		Your levies act on their own while you watch: no fear, they fall back to heal, and they go for the biggest threat.
		Map orders need it. Dropped in Slime Rain. Consumed on use, once per world.
		'''
}

SpectatorBuff: {
	DisplayName: Spectator
	Description: Enemies ignore you. Your weapons and building tools are off. You cannot leave the area. A boss you have not beaten ends it.
}

SeekerBuff: {
	DisplayName: Seeker
	Description: The item you chose glows in the world and in chests.
}

AutonomousBuff: {
	DisplayName: Autonomous
	Description: Fearless. Falls back to heal. Goes for the biggest threat.
}

SpectatorRefused: Too soon after damage.
SpectatorBossRefused: Beat this boss first.
SpectatorBossEnds: A boss you have not beaten ends it.
SeekerPrompt: Choose an item to find.
SeekerClose: Close
DropSlimeRain: Drops during Slime Rain.
EffectAutonomy: Your levies act on their own while you watch: no fear, they fall back to heal, and they go for the biggest threat. Map orders are unlocked.
NeedAutonomy: Learn the Guide to Autonomy first.
