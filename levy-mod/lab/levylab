def main():
    ap = argparse.ArgumentParser(prog="levylab", description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    sp = ap.add_subparsers(dest="cmd", required=True)
    r = sp.add_parser("run", help="build once per revision, run every cell x seed headless in parallel, print the table")
    r.add_argument("spec"); r.add_argument("--jobs", type=int, default=max(1, (os.cpu_count() or 2) - 1)); r.add_argument("--rec", type=int, default=0, help="record K seeds per cell (default 0: none)")
    r.add_argument("--per-proc", type=int, default=8, help="min fights per server process (boot is ~55 s each)"); r.add_argument("--seeds", help="override the spec's seeds"); r.add_argument("--rev", help="build this git revision instead of the working tree"); r.add_argument("--steps", type=int, default=120, help="game ticks per server turn")
    r.add_argument("--out"); r.add_argument("--rebuild", action="store_true"); r.add_argument("--quiet", action="store_true", help="skip the table at the end")
    t = sp.add_parser("table", help="markdown summary of a run dir"); t.add_argument("run_dir"); t.add_argument("--cols", help="extra results.csv columns (mean over fights), comma list"); t.add_argument("--wide", action="store_true", help="also top weapons per cell")
    sp.add_parser("list", help="every spec field, token, env toggle and preset")
    a = ap.parse_args()
    {"run": cmd_run, "table": cmd_table, "list": cmd_list}[a.cmd](a)

if __name__ == "__main__":
    main()
