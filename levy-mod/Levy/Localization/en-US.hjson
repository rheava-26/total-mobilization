		Keybinds: {
			FollowMe.DisplayName: Levy: Follow me
			HoldHere.DisplayName: Levy: Hold here
			ReturnToBarracks.DisplayName: Levy: Return to barracks
			HoldFire.DisplayName: Levy: Hold fire / fire at will
			Mobilize.DisplayName: Levy: Mobilize / stand down
			Rally.DisplayName: Levy: Rally
			ArmyStrip.DisplayName: Levy: Army overview
		}

		Configs: {
			WeaponRankMode: {
				Balanced: {
					Label: Balanced
					Tooltip: Sell price, lowered for weapons far behind your progress and raised for recent Armory additions
				}

				SellPrice: {
					Label: Sell price
					Tooltip: Sell price
				}

				SellPricePlusMaterials: {
					Label: Sell price + materials
					Tooltip: Sell price plus the cost of the materials in the cheapest recipe
				}

				Damage: {
					Label: Damage
					Tooltip: Damage per second, raised for rarity and price
				}

				Tooltip: ""
			}

			FearModelSetting: {
				Events: {
					Label: Events
					Tooltip:
						'''
						Levies fear events, bosses, hits of 30% of their health,
						deaths within 40 tiles and boss phase changes
						Fear drains after 3 seconds without a hit
						'''
				}

				Proximity: {
					Label: Proximity
					Tooltip: Levies fear a boss steadily while it is in view, and more when hit or when a levy dies
				}

				Tooltip: ""
			}

			LevyConfig: {
				DisplayName: Levy

				Headers: {
					Potions: Potions and mana
					Aim: Aim
					BossBehaviour: Boss behaviour
					LevyCounts: Levy and militia counts
					Slots: Slots
					ArmoryRanking: Armory and ranking
					Hooks: Hooks
					GearUpkeep: Gear upkeep
					Soldiers: Soldiers
					Economy: Economy
					Events: Events
					Interface: Interface
					Crowd: Crowd
				}

				ArmyEntityBudget: {
					Label: Army entity budget
					Tooltip: Minions, sentries, lingering shots and drones stand down, oldest first, to keep free projectile and NPC slots
				}

				ReservedProjectileSlots: {
					Label: Projectile slots kept free
					Tooltip: Free projectile slots the army always leaves
				}

				ReservedNpcSlots: {
					Label: NPC slots kept free
					Tooltip: Free NPC slots drones always leave
				}

				ArmySoundVolume: {
					Label: Army sound volume
					Tooltip: Volume of every sound the army makes
				}

				BossHpScalingPercentPerCp: {
					Label: Boss HP scaling per command point (%)
					Tooltip: Max and current HP a boss gains for every command point of soldiers engaging it
				}

				BossHpScalingCapPercent: {
					Label: Boss HP scaling cap (%)
					Tooltip: The most a boss can gain from engaged soldiers.
				}

				BossesPunishSoldiers: {
					Label: Bosses punish soldiers
					Tooltip: Bosses aim shots and dashes at soldiers that get close or hurt them
				}

				BossesTargetSoldiers: {
					Label: Bosses target soldiers
					Tooltip: Bosses you have beaten chase the nearest soldier, but first kills stay solo. Needs Enemies target soldiers.
				}

				FearMultiplier: {
					Label: Fear multiplier
					Tooltip: Scales every fear gain during boss fights.
				}

				FearModel: {
					Label: Fear model
					Tooltip:
						'''
						Events: fear from big hits, nearby deaths and phase changes
						Proximity: fear builds while a boss is in view
						'''
				}

				FormationDefense: {
					Label: Formation defense
					Tooltip: Each steady levy within 15 tiles reduces a levy's damage taken by 2%, up to 20%
				}

				SoldierDamageMultiplier: {
					Label: Soldier damage multiplier
					Tooltip: Scales all soldier damage.
				}

				RenderCap: {
					Label: Soldiers on screen
					Tooltip: Soldiers above this number wait in the Barracks as reinforcements
				}

				Tombstones: {
					Label: Tombstones
					Tooltip: Vanilla drops one only for a Hardcore commander.
				}

				EnemiesTargetSoldiers: {
					Label: Enemies target soldiers
					Tooltip: Allowlisted enemies chase the nearest soldier like a player
				}

				UseVanillaStatPipeline: {
					Label: Use vanilla stat pipeline
					Tooltip: Soldiers get armor set and accessory stats from the game's own equipment code. Turn off if another mod misbehaves
				}

				AutoFeedCrystals: {
					Label: Soldiers use growth crystals from the Armory
					Tooltip: Soldiers use Life Crystals, Life Fruit and Mana Crystals from their Armory up to their grade limit
				}

				ArmoryTurnsStarsIntoMana: {
					Label: Levies use Fallen Stars as Mana Crystals
					Tooltip: Fallen Stars in an Armory become Mana Crystals for magic levies at the crafting cost. Stars are kept while a weapon there fires them
				}

				RealWeaponShoot: {
					Label: Real weapon effects
					Tooltip: Soldiers fire through the game's own shooting code, so special weapons keep their effects
				}

				ClassMatchIssue: {
					Label: Fixed-class companies
					Tooltip: Off, soldiers take the strongest weapon they can use. On, a soldier's armor decides its weapon class
				}

				WeaponRanking: {
					Label: Weapon ranking
					Tooltip: What the Armory ranks weapons by
				}

				SkipArmoredWeapons: {
					Label: Skip weapons that barely hurt armored enemies
					Tooltip: Weapons that barely hurt your world's enemies rank below weapons that do real damage. Applies to price rankings
				}

				AimAccuracy: {
					Label: Levy aim accuracy
					Tooltip: Higher values make levies aim better
				}

				AutoUpgradeWeapons: {
					Label: Soldiers upgrade their gear
					Tooltip: Soldiers swap to a clearly better stocked weapon or armor set and return the old one. Skips Lock Loadout
				}

				SoldiersTriggerPressurePlates: {
					Label: Soldiers trigger pressure plates
					Tooltip: Off by default.
				}

				SoldierEffectsAtSoldier: {
					Label: Weapon effects start at the soldier
					Tooltip: Weapon effects a levy triggers start at the levy.
				}

				RealGearUpkeep: {
					Label: Worn gear runs every tick
					Tooltip: A levy's accessories and armor run their per-tick effects, as a player's do.
				}

				SoldiersUseHooks: {
					Label: Levies use grappling hooks
					Tooltip: Levies carry the best grappling hook in the Armory and use it to cross gaps and climb cliffs
				}

				SoldiersTakeFallDamage: {
					Label: Levies take fall damage
					Tooltip: Levies take fall damage by the player's rules. Wings, a Lucky Horseshoe and water landings spare them.
				}

				AmbientChatter: {
					Label: Idle chatter
					Tooltip: Idle levies talk to a nearby comrade every 18 to 45 seconds. Needs a player within 70 tiles
				}

				FreeReinRadius: {
					Label: Free Rein range
					Tooltip: How far Free Rein levies roam from home, in tiles
				}

				FreeReinPastimes: {
					Label: Free Rein pastimes
					Tooltip: Calm levies on Free Rein fly kites, roast marshmallows, drink and sleep near home
				}

				LeviesSitWhenIdle: {
					Label: Levies sit when idle
					Tooltip: Idle levies sit on a nearby chair, bench or throne and stand up for a fight or an order
				}

				SoldiersTakeTileHazards: {
					Label: Levies take tile hazards
					Tooltip: Spikes, thorns, cactus, meteorite and hellstone hurt levies as they hurt players
				}

				ExtraTargetingAiStyles: {
					Label: Extra targeting AI styles
					Tooltip: Additional NPC aiStyle numbers that may target soldiers.
				}

				WageMultiplier: {
					Label: Wage multiplier
					Tooltip: Scales every wage and fee.
				}

				WageMutiny: {
					Label: Wage mutiny
					Tooltip: Soldiers the treasury cannot pay refuse orders, rob town NPCs and attack you until they are paid
				}

				AutoMusterDefault: {
					Label: Auto-muster by default
					Tooltip: New barracks call the militia when an invasion or Blood Moon starts.
				}

				OldOnesArmyUsesLevySentries: {
					Label: Old One's Army uses levy sentries
					Tooltip: Regular levies stand down during the Old One's Army. Levy sentries call them up for Etherian Mana
				}

				MilitiaFieldCap: {
					Label: Militia on the field at once
					Tooltip: Militia a town fields at once. The rest of its manpower stays in reserve
				}

				LeviesAtStart: {
					Label: Levies at the start
					Tooltip: Levies you can field in a new world. Recommended 6 to 20
				}

				LeviesByEndOfPreHardmode: {
					Label: Levies by the Wall of Flesh
					Tooltip: Levies you can field once every pre-hardmode boss is beaten. Recommended 12 to 40
				}

				LeviesByEndOfHardmode: {
					Label: Levies by Moon Lord
					Tooltip: Levies you can field once Moon Lord and every boss before him is beaten. Recommended 24 to 60
				}

				LeviesByEndOfPostMoonLord: {
					Label: Levies by the end of post-Moon Lord
					Tooltip: The most levies you can field after Moon Lord. Recommended 32 to 90
				}

				CapLeviesByStage: {
					Label: Cap levies by stage
					Tooltip: Holds the levy count at each stage's number until the next milestone boss falls. Off leaves only Maximum levies
				}

				MaxLevies: {
					Label: Maximum levies
					Tooltip: The most levies you can ever field
				}

				MilestoneRewards: {
					Label: Boss milestones
					Tooltip: A boss you beat grants every levy extra accessory slots and the world extra levies. All start off
				}

				LevyAccessorySlots: {
					Label: Levy accessory slots
					Tooltip: Accessory slots a Levy opens. At least 2, at most 6
				}

				ManAtArmsAccessorySlots: {
					Label: Man-at-Arms accessory slots
					Tooltip: Accessory slots a Man-at-Arms opens. At least 2, at most 6
				}

				ChampionAccessorySlots: {
					Label: Champion accessory slots
					Tooltip: Accessory slots a Champion opens. At least 2, at most 6
				}

				ExpertiseGuideSlots: {
					Label: A Guide to Expertise slots
					Tooltip: Accessory slots every levy gains when the Guide to Expertise is read. Boss milestones add more.
				}

				NurseHealsSoldiers: {
					Label: Nurse heals soldiers
					Tooltip: Soldiers within 4 tiles of the Nurse are healed at her price from the treasury.
				}

				Spoils: {
					Label: Soldiers loot coins
					Tooltip: Coins dropped near a soldier go into their barracks treasury. Coins near you are left alone.
				}

				MagicStorageSupply: {
					Label: Armories draw from Magic Storage
					Tooltip: Armories within 50 tiles of a Magic Storage network arm soldiers from it when their own shelves run dry. Needs Magic Storage
				}

				LogisticsReachesPylons: {
					Label: Logistics reaches shopkeepers through pylons
					Tooltip: An Armory within 60 tiles of a working pylon also trades with shopkeepers near any other working pylon
				}

				Nameplates: {
					Label: Nameplates
					Tooltip: Name, grade and HP over each soldier. Hidden above 20 on screen
				}

				MilitiaDeathMessages: {
					Label: Militia death messages
					Tooltip: Count posts one line when the event ends.
				}

				RegularDeathMessages: {
					Label: Regular death messages
					Tooltip: A chat line when a Regular dies.
				}

				DoNotAttackNpcNames: {
					Label: Do Not Attack Npc Names
					Tooltip: ""
				}
			}

