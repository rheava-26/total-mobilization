				}
			}

			MilitiaDeathMessageMode: {
				Tooltip: ""

				Count: {
					Label: Count
					Tooltip: ""
				}

				Individual: {
					Label: Individual
					Tooltip: ""
				}

				None: {
					Label: None
					Tooltip: ""
				}
			}

			ObserveConfig: {
				DisplayName: Observe Config
				Headers.ArenaView: Arena View Header

				ArenaZoomPerSide: {
					Label: Arena Zoom Per Side
					Tooltip: ""
				}

				SkipDustAndGoreInArena: {
					Label: Skip Dust And Gore In Arena
					Tooltip: ""
				}

				MindControlOnDeath: {
					Label: Mind Control On Death
					Tooltip: ""
				}
			}
		}

