def done_set(path):
    d = set()
    if path.exists():
        for r in csv.DictReader(open(path, errors="replace"), delimiter="\t"):
            m = re.search(r"\|t(c\d+)(?:\||$)", r["key"])
            if m: d.add((m[1], int(r["seed"])))
    return d

def cmd_run(a):
    G, P, S = load_gear(), load_simple("potions.yaml"), load_simple("stations.yaml")
    spec = load_spec(a.spec); cells = expand(spec)
    if a.seeds:
        for c in cells: c["seeds"] = parse_seeds(a.seeds)
    cells = [c if "raw" in c else resolve(c, G, P, S) for c in cells]
    if a.seeds:
        for c in cells: c["seeds"] = parse_seeds(a.seeds)
    mods = {c.get("mods", "calamity") for c in cells if "raw" not in c} or {"calamity"}
    if len(mods) > 1: die("one run = one `mods:` value; split vanilla and Calamity runs (NORTH_STAR keeps them separate)")
    name = spec.get("name"); rundir = Path(a.out) if a.out else HOME / "runs" / f"{name}-{time.strftime('%Y%m%d-%H%M%S')}"
    rundir.mkdir(parents=True, exist_ok=True); (rundir / "armies").mkdir(exist_ok=True)
    tmod, bid, built = build(a.rev, a.rebuild)
    # fights: (cell id, seed, line)
    fights = []; meta_cells = []
    for c in cells:
        if "raw" in c:
            for r in c["raw"]: fights.append((c["id"], int(r[3]), "\t".join(r + [f"tag={c['id']}"]), c["seeds"].index(int(r[3])) < a.rec))
            meta_cells.append(dict(id=c["id"], name=c["name"], seeds=c["seeds"], raw=True)); continue
        gear = c["_gear"]; cp = cost_params(c, P, S)
        for k, sd in enumerate(c["seeds"]):
            if not gear.get("legacy"):
                army = roll_army(gear, P[c["_pn"]], S[c["_sn"]], int(c["levies"]), int(c["hp"]), sd)
                (rundir / "armies" / f"{c['id']}_{sd}.json").write_text(json.dumps(army))
            fights.append((c["id"], sd, fight_line(c, sd, rundir), k < a.rec))
        meta_cells.append(dict(id=c["id"], name=c["name"], boss=c["boss"], mode=c["mode"], gear=c["gear"], potions=c["_pn"], stations=c["_sn"], levies=c["levies"], hp=c["hp"], arena=c["arena"],
                               cap=c["cap"], seeds=c["seeds"], cost=cp, env=c.get("env") or {}, tokens=c.get("tokens") or []))
    # cells with different env toggles run in different processes (env is process-wide); recorded fights get their own processes
    cenv = {c["id"]: {k: str(v) for k, v in (c.get("env") or {}).items()} for c in cells if "raw" not in c}
    groups = {}
    for f in fights: groups.setdefault((json.dumps(cenv.get(f[0], {}), sort_keys=True), f[3]), []).append(f)
    nf = len(fights); nj = max(1, min(a.jobs, round(nf / a.per_proc)))   # a server process costs ~55-100 s to boot: keep >= per_proc fights on each
    alloc = {g: max(1, int(nj * len(fs) / nf)) for g, fs in groups.items()}
    for g in sorted(groups, key=lambda g: -(nj * len(groups[g]) / nf - alloc[g])):   # largest remainder first
        if sum(alloc.values()) < nj and alloc[g] < len(groups[g]): alloc[g] += 1
    jobs = []
    for (ek, rec), fs in groups.items():
        parts = min(alloc[(ek, rec)], len(fs))
        for p in range(parts):
            jobs.append(dict(id=f"j{len(jobs)}", fights=[(x[0], x[1], x[2]) for x in fs[p::parts]], rec=rec, env=json.loads(ek)))
    ctx = dict(rundir=rundir, tmod=tmod, mods=next(iter(mods)), steps=a.steps, env={})
    t0 = time.time()
    print(f"levylab: {nf} fights = {len(meta_cells)} cells x seeds, {len(jobs)} server processes, {nj} in parallel, build {bid}{' (cached)' if not built else ''}, run dir {rundir}", file=sys.stderr)
    (rundir / "cells.json").write_text(json.dumps(dict(cells=meta_cells, build=bid, spec=a.spec, jobs=nj, steps=a.steps, rec=a.rec), indent=1))
    shutil.copy2(a.spec, rundir / ("spec" + Path(a.spec).suffix))
    with cf.ThreadPoolExecutor(max_workers=nj) as ex:
        outs = list(ex.map(lambda j: run_proc(j, ctx), jobs))
    wall = time.time() - t0
    collect(rundir, [o for os_ in outs for o in os_], wall, nf, jobs)
    if not a.quiet: cmd_table(argparse.Namespace(run_dir=str(rundir), cols=None, wide=False, quiet=False))

# ------------------------------------------------------------------------------------------------------------ collecting
HIT_RE = re.compile(r"(contact|proj):(.*?)/(-?\d+)=(\d+)/(\d+)")
def read_tsv(p):
    return list(csv.DictReader(open(p, errors="replace"), delimiter="\t")) if Path(p).exists() else []

def collect(rundir, outs, wall, nf, jobs):
    rows = []
    for o in outs:
        main = read_tsv(o / "out.tsv"); kit = {r["key"]: r for r in read_tsv(o / "out.tsv.kit.tsv")}
        hits = {}
        if (o / "out.tsv.hit.tsv").exists():
            for l in open(o / "out.tsv.hit.tsv", errors="replace"):
                k, _, v = l.rstrip("\n").partition("\t"); hits[k] = v
        for r in main:
            m = re.search(r"\|t(c\d+)(?:\||$)", r["key"])
            if not m: continue
            k = kit.get(r["key"], {}); head = body = tail = prj = oth = 0
            for kind, nm, ident, dmg, n in HIT_RE.findall(hits.get(r["key"], "")):
                d = int(dmg)
                if kind == "proj": prj += d
                elif ident == "13" or nm.endswith("Head"): head += d
                elif ident == "14" or nm.endswith("Body"): body += d
                elif ident == "15" or nm.endswith("Tail"): tail += d
                else: oth += d
            row = {"cell": m[1], "seed": r["seed"], "result": r["result"], "sec": r["sec"], "n": r.get("n", ""), "deaths": r["deaths"], "firstDeathSec": r.get("firstDeathSec", ""),
                   "bossMax": r["bossMax"], "bossLeft": r["bossLeft"], "takenHead": head, "takenBody": body, "takenTail": tail, "takenProj": prj, "takenOtherContact": oth}
            for c in ("dmgBoss", "dmgR", "dmgM", "dmgE", "dmgS", "dmgUnattr", "dmgHead", "dmgBody", "dmgTail", "takenBoss", "takenAdd", "takenOther", "avgHp", "potionsDrunk", "rageAct", "adrAct", "drCuts",
                      "addsPeak", "addKills", "enragedSec", "avgSurvSec", "halfSec", "hitsTaken", "avgDef", "dpsHittable"):
                if c in r: row[c] = r[c]
            row.update(rankSum=k.get("rankSum", ""), weaponDmg=k.get("weaponDmg", ""), classDmg=k.get("classDmg", ""), deathTimes=k.get("deathTimes", ""), job=o.parent.name)
            if r["result"] == "ERROR": row["note"] = r.get("perLevy", "")
            rows.append(row)
    want = {(c["id"], int(s)) for c in json.loads((rundir / "cells.json").read_text())["cells"] for s in c["seeds"]}
    have = {(r["cell"], int(r["seed"])) for r in rows}
    for cid, sd in sorted(want - have): rows.append({"cell": cid, "seed": sd, "result": "MISSING"})
    keys = []
    for r in rows:
        for k in r:
            if k not in keys: keys.append(k)
    with open(rundir / "results.csv", "w", newline="") as f:
        w = csv.DictWriter(f, fieldnames=keys); w.writeheader(); w.writerows(rows)
    miss = []
    for o in outs:
        hl = o / "harness.log"
        if hl.exists():
            for l in hl.read_text().splitlines():
                m = re.search(r"HARNESS-KIT: missing (.*)", l)
                if m: miss.append(m[1])
    meta = json.loads((rundir / "cells.json").read_text()); meta.update(wall_s=round(wall, 1), fights=nf, finished=len(have), fights_per_min=round(60 * len(have) / max(wall, 1), 2), processes=len(jobs), missing_items=sorted(set(", ".join(miss).split(", "))) if miss else [])
    (rundir / "cells.json").write_text(json.dumps(meta, indent=1))

