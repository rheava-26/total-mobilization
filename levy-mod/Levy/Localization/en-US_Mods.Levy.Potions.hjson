# Spectator and Seeker potions, the Guide to Autonomy and their buffs. Keys are relative to Mods.Levy.Potions.
SpectatorPotion: {
	DisplayName: Spectator Potion
	Tooltip:
		'''
		Enemies ignore you
		You cannot fight or build
		Ends against a boss you have not beaten
		Fatal if your levies all fall to a boss
		'''
}

SeekerPotion: {
	DisplayName: Seeker Potion
	Tooltip: Choose an item. Tiles and chests that hold it glow
}

GuideToAutonomy: {
	DisplayName: A Guide to Autonomy
	Tooltip:
		'''
		Your levies act on their own while you watch
		Levies are fearless, fall back to heal and go for the biggest threat
		Unlocks map orders
		Consumed on use, once per world
		'''
}

SpectatorBuff: {
	DisplayName: Spectator
	Description: Enemies ignore you. You cannot fight, build or leave the area
}

SeekerBuff: {
	DisplayName: Seeker
	Description: Your chosen item glows in the world and in chests
}

AutonomousBuff: {
	DisplayName: Autonomous
	Description: Fearless. Falls back to heal and goes for the biggest threat
}

LostBet: {
	Bet1: "{0} lost the bet."
	Bet2: "{0} realized prolonged poverty would kill them."
	Bet3: "{0} watched their favorite team lose."
	Bet4: "{0} realized the levies did not know what dashes were."
	Bet5: "{0} had money on the levies."
}

Forfeit: "{0} forfeited."
SpectatorRefused: Too soon after damage.
SpectatorBossRefused: Beat this boss first.
SpectatorBossEnds: A boss you have not beaten ends it.
SeekerPrompt: Choose an item to find.
SeekerClose: Close
DropSlimeRain: Drops during Slime Rain.
EffectAutonomy: Your levies act on their own while you watch: no fear, they fall back to heal, and they go for the biggest threat. Map orders are unlocked.
NeedAutonomy: Learn the Guide to Autonomy first.
