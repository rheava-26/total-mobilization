# Army meals, Fizz Can and Iceberg Shot, with their buffs. Keys are relative to Mods.Levy.Provisions.
NobodyInReach: No levies within {0} tiles.
GroupFish: Any Fish
GroupWellFed: Any Well Fed Dish
GroupPlenty: Any Plenty Satisfied Dish
GroupStuffed: Any Exquisitely Stuffed Dish

FizzPop: {
	DisplayName: Fizz Can
	Tooltip:
		'''
		Allows a double jump for {1} minutes
		Increases jump height by {0} tiles
		Lowers defense by {2}
		'''
}

FizzTank: {
	DisplayName: Case of Fizz
	Tooltip:
		'''
		Twelve cans of soda for the whole army.
		Gives your levies within {0} tiles a double jump
		and {2} tiles of extra jump height for {1} minutes.
		Lowers their defense by {3}, and hits knock them back at {4}% strength.
		'''
}

MagmaShot: {
	DisplayName: Iceberg Shot
	Tooltip:
		'''
		Provides immunity to lava and fire for {0} minutes
		"Ice-cold enough to ignore the lava."
		'''
}

MagmaCrucible: {
	DisplayName: Iceberg Tray
	Tooltip:
		'''
		Provides immunity to lava and fire for levies within {0} tiles for {1} minutes
		Levies swim through lava
		Increases aim error by {2}%
		'''
}

FishFryPlatter: {
	DisplayName: Fish Fry Platter
	Tooltip:
		'''
		Feeds the {0} nearest levies within {1} tiles
		Gives {2} for {3} minutes
		Gives Morale for {4} minutes
		'''
}

