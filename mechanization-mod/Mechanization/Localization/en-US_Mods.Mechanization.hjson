# Mechanization — player-facing strings. Keys are relative to Mods.Mechanization (prefix comes from the file name).
# Style: 1-4 short declarative sentences. What it is, reach, the numbers that matter, one special rule.
Items: {
	ArmoryRelayItem: {
		DisplayName: Armory Relay
		Tooltip:
			'''
			Links to the nearest armory within 1000 tiles, or to your pylon network.
			Turrets and drones within 25 tiles of it draw from that armory.
			'''
	}

	DroneItem: {
		DisplayName: Combat Drone
		Tooltip:
			'''
			Sets a combat drone down at the cursor. It patrols 36 tiles either side of that spot and shoots hostiles within reach of its weapon.
			Mounts the best spare ranged weapon from armories within 240 tiles or on your pylon network. With none it fires a plain bullet, reach 32 tiles.
			Right-click the drone and choose Pack up to take it back.
			'''
	}

	TurretItem: {
		DisplayName: Automatic Turret
		Tooltip:
			'''
			An automatic turret. Shoots hostiles within the reach of its mounted weapon.
			Mounts the best spare ranged weapon from armories within 240 tiles or on your pylon network. With none it fires a plain bullet, reach 32 tiles.
			'''
	}
}

Tiles.ArmoryRelayTile.MapEntry: Armory Relay

NPCs: {
	TurretNPC.DisplayName: Automatic Turret
	DroneNPC.DisplayName: Combat Drone
}

Keybinds.RecallDrones.DisplayName: Mechanization: Recall or launch drones

Configs: {
	MechConfig: {
		DisplayName: Mechanization

		FireOnUnbeatenBosses: {
			Label: Drones and turrets fire on bosses you haven't beaten
			Tooltip: Off, drones and turrets hold fire on a boss, and its parts, until you have defeated that boss once. A boss's minions are always fair game.
		}
	}
}

