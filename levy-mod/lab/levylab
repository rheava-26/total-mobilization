# ------------------------------------------------------------------------------------------------------------ presets
def tier_pick(m, t, default=None):
    """highest key <= t of a tier-keyed map (or the scalar itself)."""
    if not isinstance(m, dict): return m
    ks = [k for k in m if int(k) <= t]
    return m[max(ks, key=int)] if ks else default

def load_gear():
    g = yaml.safe_load((PRESETS / "gear.yaml").read_text())
    out = {}
    for tn, t in g["tiers"].items():
        for qn, q in g["qualities"].items():
            out[f"{tn}.{qn}"] = dict(q, name=f"{tn}.{qn}", tier=t["idx"], tier_name=tn, levies=t["levies"], stations=t["stations"] + q.get("stations_suffix", ""),
                                     desc=f"{t['desc']}; {q['desc']}", sets=g["sets"])
    for pn, p in (g.get("presets") or {}).items():
        if "extends" in p:
            base = dict(out[p["extends"]]); base.update({k: v for k, v in p.items() if k != "extends"}); base["name"] = pn; out[pn] = base
        else:
            out[pn] = dict(p, name=pn, tier=2, sets=g["sets"], legacy=True)
    return out

def load_simple(fn):
    d = yaml.safe_load((PRESETS / fn).read_text())
    if fn == "stations.yaml":
        for k, v in list(d.items()):
            d[k + ".plain"] = dict(v, honey=False, desc=v["desc"] + " (no honey)")
    return d

def parse_weapon(s):
    heavy = s.endswith("*"); s = s.rstrip("*"); w, _, kind = s.rpartition(":")
    return w, kind if kind != "-" else "", 3 if heavy else 1

def roll_army(gear, potions, stations, n, hp, seed):
    """Python port of the deathladder roll, driven by preset data. Same (gear, seed, n) = same army in every arm."""
    t = gear["tier"]; rng = random.Random(f"{gear['name']}:{seed}:{n}")
    fr = gear["mix"]; counts = {c: round(n * fr[c]) for c in "RMES"}
    counts["S"] = max(0, n - counts["R"] - counts["M"] - counts["E"])
    lc = max(0, round((hp - 100) / 20)); slots = gear["acc_slots"]; levies = []; ridx = 0
    heal = tier_pick(potions["heal"], t); cnt = potions["count"]
    for cls in "RMES":
        for _ in range(counts[cls]):
            pool = []
            for tk, ws in gear["weapons"].get(cls, {}).items():
                if int(tk) <= t: pool += [parse_weapon(w) for w in ws]
            pick = rng.randrange(sum(w[2] for w in pool)); a = 0; chosen = pool[0]
            for w in pool:
                a += w[2]
                if pick < a: chosen = w; break
            sets = tier_pick(gear["armor"][cls], t); armor = gear["sets"][rng.choice(sets)]
            armor = [x.replace("{c}", {"R": "Ranged", "M": "Magic", "E": "Melee", "S": "Summon"}[cls]) for x in armor]
            ca = gear["class_acc"][cls]; ca = tier_pick(ca, t) if isinstance(ca, dict) else ca
            acc = []
            for x in tier_pick(gear["acc"], t):
                x = ca if x == "{class}" else x
                if x not in acc: acc.append(x)
            acc = acc[:slots]
            ammo = ""
            if chosen[1]:
                a_opt = str(tier_pick(gear["ammo"][chosen[1]], t)).split("|")
                ammo = a_opt[ridx % 2 % len(a_opt)] if chosen[1] == "arr" else a_opt[0]
                ridx += 1
            nl = rng.randint(cnt[0], cnt[1]) if isinstance(cnt, list) else cnt
            levies.append(dict(cls=cls, weapon=chosen[0], ammo=ammo, armor=armor, acc=acc, lc=lc, mc=gear["mana_crystals"], potions=nl, potion=heal))
    if gear.get("chi"):
        for l in levies:
            if l["cls"] == "M": l["acc"] = l["acc"][:max(0, slots - 1)] + ["CalamityMod/TrinketofChi"]; break
    return dict(accSlots=slots, honey=bool(stations["honey"]), stations=stations["stations"], stationLevel=2, buffs=potions["buffs"], levies=levies)

# ------------------------------------------------------------------------------------------------------------ spec -> cells
def parse_seeds(s):
    if isinstance(s, str) and s.strip().isdigit(): s = int(s)
    if isinstance(s, int): return list(range(1, s + 1))
    if isinstance(s, str):
        m = re.fullmatch(r"(\d+)-(\d+)", s.strip())
        if m: return list(range(int(m[1]), int(m[2]) + 1))
        return [int(x) for x in re.split(r"[ ,]+", s.strip()) if x]
    return [int(x) for x in s]

def merge(base, over):
    r = dict(base)
    for k, v in over.items():
        if k == "env": r["env"] = {**base.get("env", {}), **(v or {})}
        elif k == "tokens": r["tokens"] = list(base.get("tokens") or []) + list(v or [])
        elif k == "cost": r["cost"] = {**(base.get("cost") or {}), **(v or {})}
        else: r[k] = v
    return r

def load_spec(path):
    p = Path(path)
    if not p.exists(): die(f"no such spec {path}")
    text = p.read_text()
    if p.suffix in (".yaml", ".yml"):
        spec = yaml.safe_load(text) or {}
    else:  # tsv: raw harness `fight` lines (passthrough), or a table: header of spec fields, one row per cell
        rows = [l.split("\t") for l in text.splitlines() if l.strip() and not l.startswith("#")]
        if rows and rows[0][0] == "fight":
            spec = {"raw": rows}
        else:
            hdr = rows[0]; cells = []
            for r in rows[1:]:
                c = {h: yaml.safe_load(v) if v != "" else None for h, v in zip(hdr, r)}
                cells.append({k: v for k, v in c.items() if v is not None})
            spec = {"cells": cells}
    spec.setdefault("name", p.stem)
    return spec

def expand(spec):
    """-> list of cells (dict with resolved fields, name, id)."""
    if "raw" in spec:
        groups = {}
        for r in spec["raw"]:
            key = tuple(r[1:3] + r[4:]); groups.setdefault(key, []).append(r)
        cells = []
        for i, (key, rs) in enumerate(groups.items()):
            cells.append(dict(id=f"c{i}", name=f"{rs[0][1]}.{rs[0][2]}" + (f" {' '.join(rs[0][5:])}" if len(rs[0]) > 5 else ""), raw=rs, seeds=[int(x[3]) for x in rs]))
        return cells
    base = {k: v for k, v in spec.items() if k not in ("vs", "grid", "cells", "name")}
    arms = [("ctl", base)]
    vs = spec.get("vs")
    if isinstance(vs, dict): arms += [(str(k), merge(base, v or {})) for k, v in vs.items()]
    elif isinstance(vs, list): arms += [(str(a.get("name", f"arm{i}")), merge(base, {k: v for k, v in a.items() if k != "name"})) for i, a in enumerate(vs)]
    if spec.get("cells"):
        arms = [(str(c.get("name", f"cell{i}")), merge(base, {k: v for k, v in c.items() if k != "name"})) for i, c in enumerate(spec["cells"])] + (arms[1:] if vs else [])
    cells = []
    for an, a in arms:
        grid = a.pop("grid", None) or spec.get("grid")
        combos = [dict()] if not grid else [dict(zip(grid, vals)) for vals in itertools.product(*[v if isinstance(v, list) else [v] for v in grid.values()])]
        for cb in combos:
            c = merge(a, cb); nm = an + ("" if not cb else " " + " ".join(f"{k}={v}" for k, v in cb.items()))
            if len(arms) == 1 and not cb: nm = spec.get("name", "cell")
            cells.append(dict(c, name=nm))
    for i, c in enumerate(cells): c["id"] = f"c{i}"
    return cells

def resolve(c, G, P, S):
    r = {**DEFAULTS, **{k: v for k, v in c.items() if v is not None}}
    for k in r:
        if k not in SPEC_KEYS and k not in ("id", "name", "raw"): die(f"unknown spec field '{k}' (see `levylab list`)")
    if r["boss"] not in BOSSES: print(f"levylab: warning: boss '{r['boss']}' is not a known boss line", file=sys.stderr)
    g = G.get(r["gear"]) or die(f"unknown gear preset '{r['gear']}' (levylab list)")
    pn = r.get("potions") or g.get("potions", "best"); sn = r.get("stations") or g.get("stations", "none")
    if not g.get("legacy"):
        if pn not in P: die(f"unknown potions preset '{pn}'")
        if sn not in S: die(f"unknown stations preset '{sn}'")
    r["_gear"], r["_pn"], r["_sn"] = g, pn, sn
    r["seeds"] = parse_seeds(r["seeds"])
    r["levies"] = r.get("levies") or g["levies"]
    hp = r.get("hp"); gh = g.get("hp", 400); r["hp"] = hp if hp is not None else tier_pick(gh, g["tier"])
    r["cap_ticks"] = int(float(r["cap"]) * TICKS)
    return r

def cost_params(r, P, S):
    g = r["_gear"]; cp = dict(g.get("cost") or {})
    if not g.get("legacy"):
        cp["pot_per_levy"] = (P[r["_pn"]].get("cost") or {}).get("per_levy", 0); cp["flat"] = (S[r["_sn"]].get("cost") or {}).get("flat", 0)
    cp.update(r.get("cost") or {})
    return cp

# ------------------------------------------------------------------------------------------------------------ build + install
def repo_root():
    o = sh(["git", "-C", str(LAB), "rev-parse", "--show-toplevel"])
    if o.returncode: die("not inside a git checkout")
    return Path(o.stdout.strip())

def lock(path):
    path.parent.mkdir(parents=True, exist_ok=True); f = open(path, "w"); fcntl.flock(f, fcntl.LOCK_EX); return f

def ensure_install():
    """one persistent private install (tML + mods + test world + build save dir), created on first use from /home/user/lab/tmlv + savev; later runs only reset per-run state."""
    if not (HOME / "tml" / "tModLoader.dll").exists():
        print("levylab: first use, creating the private install in", HOME, file=sys.stderr)
        (HOME / "tml").mkdir(parents=True, exist_ok=True)
        for f in SRC_TML.iterdir():
            if f.name == "tModLoader-Logs": continue
            (shutil.copytree if f.is_dir() else shutil.copy2)(f, HOME / "tml" / f.name, symlinks=True)
        (HOME / "tml" / "tModLoader-Logs").mkdir(exist_ok=True)
    save = HOME / "build" / "save"; (save / "ModSources").mkdir(parents=True, exist_ok=True); (save / "Mods").mkdir(exist_ok=True)
    for m in (SRC_SAVE / "Mods").iterdir():
        if m.suffix == ".tmod" and m.name != "Levy.tmod" and not (save / "Mods" / m.name).exists(): os.symlink(os.path.realpath(m), save / "Mods" / m.name)
    tg = save / "ModSources" / "tModLoader.targets"
    if not tg.exists(): tg.write_text(f'<Project ToolsVersion="14.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">\n  <Import Project="{HOME}/tml/tMLMod.targets" />\n</Project>')
    if not (HOME / "world" / "W.wld").exists():
        (HOME / "world").mkdir(exist_ok=True)
        w = WORLD_SRC if WORLD_SRC.exists() else die("test world LevyTest.wld not found")
        shutil.copy2(w, HOME / "world" / "W.wld"); shutil.copy2(w.with_suffix(".twld"), HOME / "world" / "W.twld")

def build(rev, force=False):
    """-> path of the cached .tmod for this git revision (built once; the cache key is the commit, plus a hash of uncommitted changes)."""
    root = repo_root(); ensure_install()
    if rev:
        sha = sh(["git", "-C", str(root), "rev-parse", rev]).stdout.strip() or die(f"unknown rev {rev}"); bid = sha[:12]
    else:
        sha = sh(["git", "-C", str(root), "rev-parse", "HEAD"]).stdout.strip(); bid = sha[:12]
        dirty = sh(["git", "-C", str(root), "diff", "HEAD", "--", "levy-mod/Levy"]).stdout
        untracked = sorted(sh(["git", "-C", str(root), "ls-files", "-o", "--exclude-standard", "levy-mod/Levy"]).stdout.split())
        if dirty or untracked:
            h = hashlib.sha1(dirty.encode())
            for f in untracked: h.update(f.encode()); h.update((root / f).read_bytes())
            bid += "-" + h.hexdigest()[:8]
    tmod = HOME / "cache" / f"{bid}.tmod"
    if tmod.exists() and not force: return tmod, bid, False
    with lock(HOME / "build" / ".lock"):
        if tmod.exists() and not force: return tmod, bid, False
        t0 = time.time(); print(f"levylab: building Levy @ {bid} ...", file=sys.stderr)
        tmp = None; src = root / "levy-mod" / "Levy"
        if rev:
            tmp = Path(tempfile.mkdtemp(prefix="levylab-src-")); subprocess.run(f"git -C {root} archive {sha} levy-mod/Levy | tar -x -C {tmp}", shell=True, check=True); src = tmp / "levy-mod" / "Levy"
        save = HOME / "build" / "save"; ms = save / "ModSources" / "Levy"
        shutil.rmtree(ms, ignore_errors=True); shutil.copytree(src, ms, ignore=shutil.ignore_patterns("bin", "obj", "docs"))
        (save / "Mods" / "Levy.tmod").unlink(missing_ok=True)
        env = {**os.environ, "DOTNET_ROOT": DOTNET, "PATH": DOTNET + ":" + os.environ["PATH"], "DOTNET_NOLOGO": "1", "DOTNET_CLI_TELEMETRY_OPTOUT": "1"}
        log = HOME / "build" / "last_build.log"
        with open(log, "w") as lf:
            subprocess.run(["dotnet", "tModLoader.dll", "-server", "-nosteam", "-tmlsavedirectory", str(save), "-build", str(ms)], cwd=HOME / "tml", env=env, stdout=lf, stderr=subprocess.STDOUT, timeout=1500)
        if tmp: shutil.rmtree(tmp, ignore_errors=True)
        out = save / "Mods" / "Levy.tmod"
        if not out.exists():
            errs = [l for l in log.read_text().splitlines() if " error " in l][:8]
            die("build failed:\n" + "\n".join(errs) + f"\n(full log {log})")
        (HOME / "cache").mkdir(exist_ok=True); shutil.copy2(out, tmod)
        print(f"levylab: built in {time.time() - t0:.0f}s -> {tmod.name}", file=sys.stderr)
    return tmod, bid, True

def ensure_slot(i):
    s = HOME / "slots" / str(i); tml = s / "tml"
    if not (tml / "tModLoader.dll").exists():
        tml.mkdir(parents=True, exist_ok=True)
        for f in (HOME / "tml").iterdir():   # files are copied (tML puts its logs next to the real dll path), directories are linked
            if f.name == "tModLoader-Logs": continue
            d = tml / f.name
            if f.is_dir(): d.unlink(missing_ok=True); os.symlink(f, d)
            else: shutil.copy2(f, d)
        (tml / "tModLoader-Logs").mkdir(exist_ok=True)
    mods = s / "save" / "Mods"; mods.mkdir(parents=True, exist_ok=True)
    for m in (HOME / "build" / "save" / "Mods").glob("*.tmod"):
        if m.name != "Levy.tmod" and not (mods / m.name).exists(): os.symlink(os.path.realpath(m), mods / m.name)
    return s

class Slot:
    def __init__(self):
        self.f = None; self.i = None
    def __enter__(self):
        while True:
            for i in range(MAX_SLOTS):
                (HOME / "slots").mkdir(parents=True, exist_ok=True); f = open(HOME / "slots" / f".lock{i}", "w")
                try: fcntl.flock(f, fcntl.LOCK_EX | fcntl.LOCK_NB); self.f, self.i = f, i; return self
                except OSError: f.close()
            time.sleep(2)
    def __exit__(self, *a): fcntl.flock(self.f, fcntl.LOCK_UN); self.f.close()

# ------------------------------------------------------------------------------------------------------------ running
def fight_line(cell, seed, rundir):
    t = ["cmd=" + str(cell["cmd"]), "order=" + str(cell["order"]), "arena=" + str(cell["arena"]), "tag=" + cell["id"]]
    g = cell["_gear"]
    if g.get("legacy"): t += ["gear=mod", "grade=lv", "l3=1", "n=cp"] + g["tokens"]
    else: t += ["lv=" + str(rundir / "armies" / f"{cell['id']}_{seed}.json")]
    for k in TOKENS:
        if k in cell and cell[k] is not None: t.append(f"{k}={cell[k]}")
    t += [str(x) for x in (cell.get("tokens") or [])]
    return "\t".join(["fight", str(cell["boss"]), str(cell["mode"]), str(seed), str(cell["cap_ticks"])] + t)

def run_proc(job, ctx):
    """one server process running job['fights'] sequentially; retries the unfinished ones after a crash. -> list of out dirs."""
    with Slot() as sl:
        s = ensure_slot(sl.i); out = ctx["rundir"] / "jobs" / job["id"]; out.mkdir(parents=True, exist_ok=True)
        todo = list(job["fights"]); outs = []
        for attempt in range(3):
            if not todo: break
            a = out / f"try{attempt}"; a.mkdir(exist_ok=True); outs.append(a)
            save = s / "save"; shutil.rmtree(save / "Worlds", ignore_errors=True); (save / "Worlds").mkdir(); shutil.rmtree(save / "ModConfigs", ignore_errors=True)
            shutil.copy2(HOME / "world" / "W.wld", save / "Worlds" / "W.wld"); shutil.copy2(HOME / "world" / "W.twld", save / "Worlds" / "W.twld")
