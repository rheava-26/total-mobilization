# Levy — every player-facing string except soldier dialogue (Dialogue/en-US.txt).
# Style: 1-4 short declarative sentences. What it is, reach, the numbers that matter, one special rule.
Mods: {
	Levy: {
		Items: {
			BarracksItem: {
				DisplayName: Barracks
				Tooltip:
					'''
					Town NPCs within 120 tiles belong to it
					Right click it to enlist Regulars and raise the militia
					'''
			}

			ArmoryItem: {
				DisplayName: Armory
				Tooltip:
					'''
					Stores 1000 items
					Arms the soldiers of Barracks within 120 tiles
					'''
			}

			LogisticalCenterItem: {
				DisplayName: Logistical Center
				Tooltip: Adds 250 slots to the nearest Armory within 40 tiles
			}

			PatrolBannerItem: {
				DisplayName: Patrol Banner
				Tooltip:
					'''
					Place two to mark a patrol line
					Assign Regulars to it from the Barracks
					'''
			}

			WarHorn: {
				DisplayName: War Horn
				Tooltip:
					'''
					Left click to call up or stand down the militia
					Right click to give orders to your Regulars
					'''
			}

			SpectralLens: {
				DisplayName: Spectral Lens
				Tooltip:
					'''
					Makes levies, their weapons, shots and summons 85% transparent
					Only you see the effect
					'''
			}

			CommandRadio: {
				DisplayName: Command Radio
				Tooltip:
					'''
					Orders and Rally reach every levy in the world
					Click to open the command radial
					Double-click the map to send the army there
					'''
			}

			GoProItem: {
				DisplayName: GoPro
				Tooltip:
					'''
					Equipped by a levy in its camera slot
					Use to see through the next GoPro levy
					Right click to open the camera view
					'''
			}

			StaticCameraItem: {
				DisplayName: Static Camera
				Tooltip:
					'''
					Right click it from anywhere in reach to see its view
					Mouse wheel zooms out
					'''
			}

			MindLinkItem: {
				DisplayName: Mind Link
				Tooltip:
					'''
					Take control of the levy nearest your cursor
					Right click to let go
					If you die, you control a levy until you respawn
					'''
			}

			FieldManual: {
				DisplayName: Field Manual
				Tooltip: Opens a guide to raising and commanding levies
			}

			GuideToConscription: {
				DisplayName: A Guide to Conscription
				Tooltip:
					'''
					Increases manpower per town NPC to 15
					Consumed on use, once per world
					'''
			}

			GuideToDrill: {
				DisplayName: A Guide to Drill
				Tooltip:
					'''
					Reduces militia aim error by 25%
					Consumed on use, once per world
					'''
			}

			GuideToPlunder: {
				DisplayName: A Guide to Plunder
				Tooltip:
					'''
					Increases coins hauled to the treasury by 50%
					Consumed on use, once per world
					'''
			}

			GuideToFortification: {
				DisplayName: A Guide to Fortification
				Tooltip:
					'''
					Increases defense by 4 for soldiers within 60 tiles of a Barracks
					Consumed on use, once per world
					'''
			}

			GuideToDiscipline: {
				DisplayName: A Guide to Discipline
				Tooltip:
					'''
					Reduces soldier aim error by 35%
					Consumed on use, once per world
					'''
			}

			GuideToFirepower: {
				DisplayName: A Guide to Firepower
				Tooltip:
					'''
					Increases militia life by 100 and mana by 80
					Adds 2 buff slots to every Armory
					Consumed on use, once per world
					'''
			}

			GuideToHealthcare: {
				DisplayName: A Guide to Healthcare
				Tooltip:
					'''
					Increases militia life by 150
					Consumed on use, once per world
					'''
			}

			GuideToTheArcaneArts: {
				DisplayName: A Guide to the Arcane Arts
				Tooltip:
					'''
					Increases militia mana by 60
					Consumed on use, once per world
					'''
			}

			GuideToExpertise: {
				DisplayName: A Guide to Expertise
				Tooltip:
					'''
					Increases accessory slots by 1 for every soldier
					Consumed on use, once per world
					'''
			}

			GuideToEngineering: {
				DisplayName: A Guide to Engineering
				Tooltip:
					'''
					Unlocks combat drones at every Barracks
					Each drone mounts a spare ranged or magic weapon
					Requires the Mechanization mod
					Consumed on use, once per world
					'''
			}

			LevyRod: {
				DisplayName: Levy Rod
				Tooltip:
					'''
					Summons a levy sentry during the Old One's Army
					Calls up {0} levy
					Costs {1} Etherian Mana
					'''
			}

			LevyCane: {
				DisplayName: Levy Cane
				Tooltip:
					'''
					Summons a levy sentry during the Old One's Army
					Calls up {0} levies
					Costs {1} Etherian Mana
					'''
			}

			LevyStaff: {
				DisplayName: Levy Staff
				Tooltip:
					'''
					Summons a levy sentry during the Old One's Army
					Calls up {0} levies
					Costs {1} Etherian Mana
					'''
			}

			BarracksAle: {
				DisplayName: Barracks Keg
				Tooltip:
					'''
					Increases defense by {2} for levies within {0} tiles for {1} minutes
					Increases aim error by {3}%
					'''
			}

			BlackStout: {
				DisplayName: Case of Stout
				Tooltip:
					'''
					Increases damage by {2}% for levies within {0} tiles for {1} minutes
					Increases aim error by {3}%
					'''
			}

			MeteorBeacon: {
				DisplayName: Meteor Beacon
				Tooltip: Calls down a meteor when used at night
			}

			SpicedRum: {
				DisplayName: Rum Cooler
				Tooltip:
					'''
					Increases critical strike chance by {2}% for levies within {0} tiles for {1} minutes
					Increases aim error by {3}%
					'''
			}
		}

		Tiles: {
			BarracksTile.MapEntry: Barracks
			ArmoryTile.MapEntry: Armory
			LogisticalCenterTile.MapEntry: Logistical Center
			PatrolBannerTile.MapEntry: Patrol Banner
			StaticCameraTile.MapEntry: Static Camera
		}

