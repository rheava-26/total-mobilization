<Project Sdk="Microsoft.NET.Sdk">
  <!-- Command-line performance analyzer: the very source files the mod runs (no game types in them), compiled into a console tool.
       Build and run with the .NET 10 SDK: dotnet run with this project and the arguments of Program.cs.
       Compiled in: the window model and the lag decision, the rolling log file code, and the pure self-check. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>disable</Nullable>
    <LangVersion>12</LangVersion>
    <ImplicitUsings>disable</ImplicitUsings>
    <RootNamespace>PerfAnalyze</RootNamespace>
    <NoWarn>CS0649;CS0169;CS0414;CS8981</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../../Levy/Common/Perf/PerfModel.cs" Link="PerfModel.cs" />
    <Compile Include="../../Levy/Common/Perf/PerfLogFile.cs" Link="PerfLogFile.cs" />
    <Compile Include="../../Levy/Common/Perf/PerfSelfTest.cs" Link="PerfSelfTest.cs" />
  </ItemGroup>
</Project>
