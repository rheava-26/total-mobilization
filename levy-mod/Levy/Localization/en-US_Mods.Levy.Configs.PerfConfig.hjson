# Keys here are relative to Mods.Levy.Configs.PerfConfig (the performance analyzer).
DisplayName: Levy: Performance

Headers: {
	Analyzer: Performance log
	LagPopup: After a laggy fight
	Effects: Army effects
	Speed: Speed in big fights
}

PerfLogAlwaysOn: {
	Label: Record a performance log
	Tooltip: Writes a window of numbers every eight seconds to the perf folder next to the recordings. Type /levyperf to see the last minute.
}

PerfLogDays: {
	Label: Days to keep the log
	Tooltip: Older log files are deleted.
}

PerfLogMaxMB: {
	Label: Largest log folder (MB)
	Tooltip: The oldest log files are deleted first when the folder is over this size.
}

MeasureOtherModHooks: {
	Label: Measure other mods' AI hooks
	Tooltip: Times the NPC and projectile AI hooks other mods add, so the log can name them. Needs a reload.
}

LagPopup: {
	Label: Show a note after a laggy fight
	Tooltip: After a boss fight that ran badly, a small window says where the time went.
}

LagPopupDontAskAgain: {
	Label: Never ask about lag
	Tooltip: Set by Don't ask again in the note.
}

LevyEffects: {
	Label: Army effects
	Tooltip: Reduced hides nameplates and thins the dust levy weapons throw. The army fights the same.
}

GearUpdateIntervalWhenFighting: {
	Label: Gear update interval when fighting
	Tooltip:
		'''
		How often a fighting levy recalculates his gear's stats, in ticks. 1 is every tick, as a player does.
		Higher is faster in big fights. Rage, Adrenaline, stealth and cooldowns still run every tick, and a change of gear, buffs or held weapon recalculates at once.
		'''
}

ActiveArmySize: {
	Label: Active army size
	Tooltip:
		'''
		Soldiers in the field at once. 0 fields all of them.
		When one falls, the next in reserve takes their place right away.
		'''
}

ArmyNoticeDontAskAgain: {
	Label: Never ask about army size
	Tooltip: Set by Don't ask again in the army size note.
}

FrameSkip: {
	Label: Frame Skip
	Tooltip: The game's Frame Skip setting. Subtle keeps the picture moving in heavy fights by slowing the game slightly.
}
