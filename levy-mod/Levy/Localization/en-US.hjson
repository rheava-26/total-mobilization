		Chat: {
			Militia: Militia
			MilitiaCalledUp: The militia of {0} has been called up!
			MilitiaStandsDown: The militia of {0} stands down.
			NoOneLeft: "{0} has no one left to send."
			Payday: Paid the garrison: {0}.
			Unpaid: The treasury of {0} could not cover the garrison.
			Deserted: "{0} has deserted, taking {1} and no regrets."
			MilitiaLost: "{0} lost {1} militia."
