# Keys here are relative to Mods.Levy.Configs.FightRecConfig (the automatic fight recorder).
DisplayName: Levy: Fight recorder

Headers: {
	Recording: Recording
	Limits: Limits
}

RecordFightsAutomatically: {
	Label: Record fights automatically
	Tooltip: Saves a recording of each fight. All fights also saves fights your army joins.
}

ProfileRecordedFights: {
	Label: Profile recorded fights
	Tooltip: Measures where the time goes during each recorded fight and saves it in the recording. One line in chat when the fight ends.
}

RecordingFolder: {
	Label: Recording folder
	Tooltip: Full path of the folder. Leave empty for Levy/Recordings in the tModLoader save folder.
}

MaxFileSizeMB: {
	Label: Largest recording (MB)
	Tooltip: Recording stops when a file reaches this size.
}

MaxFolderSizeMB: {
	Label: Folder size limit (MB)
	Tooltip: The oldest recordings are deleted when the folder grows past this.
}
