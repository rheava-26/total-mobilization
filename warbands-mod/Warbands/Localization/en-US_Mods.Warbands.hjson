# Warbands: player-facing strings. Keys are relative to Mods.Warbands (prefix comes from the file name).
# Style: 1-4 short declarative sentences. What it is, reach, the numbers that matter, one special rule.
Chat: {
	Arrive: "{0} are on the road."
	Beaten: The {0} are beaten. Their bounty notice lies where the last one fell.
	EventArrive: "{0} join the fight."
}

NPCs: {
	BandSoldier.DisplayName: Warband Soldier
	BandLevyNPC.DisplayName: Band Soldier
	PlayerStandIn.DisplayName: Player Stand-In
}

Configs: {
	WarbandsConfig: {
		DisplayName: Warbands

		Enabled: {
			Label: Hostile bands
			Tooltip: Armed bands form near you in the open and fight you and your levies.
		}

		FirstStage: {
			Label: First stage
			Tooltip: No bands before this stage. 0 pre-boss, 1 Eater of Worlds or Brain of Cthulhu, 2 Skeletron, 3 early Hardmode, 4 mechanical bosses, 5 Plantera, 6 Golem.
		}

		SpawnChancePercentPerMinute: {
			Label: Chance per minute
			Tooltip: Percent chance each real minute that a band forms near a player in the open.
		}

		BandSizeMin: {
			Label: Smallest band
			Tooltip: Fewest soldiers in a band.
		}

		BandSizeMax: {
			Label: Largest band
			Tooltip: Most soldiers in a band.
		}

		MaxActiveBands: {
			Label: Bands near a player
			Tooltip: Most bands within 200 tiles of one player.
		}

		MaxWorldBands: {
			Label: Max World Bands
			Tooltip: ""
		}

		BandCleanupMinutes: {
			Label: Band Cleanup Minutes
			Tooltip: ""
		}

		UseLevyLines: {
			Label: Use Levy Lines
			Tooltip: ""
		}

		GearDrops: {
			Label: Gear drops (not recommended)
			Tooltip: Fallen soldiers drop their weapons, ammo and armor. Off by default.
		}

		LootSharePercent: {
			Label: Gear drop chance
			Tooltip: With gear drops on, percent chance each piece of a fallen soldier's gear drops.
		}

		NeutralBandPercent: {
			Label: Neutral bands
			Tooltip: Percent of natural bands that ignore you until hit. Sunken Sea bands are always neutral and summoned bands always hostile.
		}

		LifeScale: {
			Label: Life scale
			Tooltip: Multiplies every soldier's life.
		}

		DamageScale: {
			Label: Damage scale
			Tooltip: Multiplies every soldier's damage.
		}

		LevyBrain: {
			Label: Levy brain
			Tooltip: Band soldiers move, hook, fly, dodge and fight the way your levies do.
		}

		SummonedBandSize: {
			Label: Summoned band size
			Tooltip: Soldiers a summoning item calls. One more per ten active levies, at most 8.
		}

		CultistBand: {
			Label: Cultist band
			Tooltip: Cultist Archers fight as a band. Lunatic Devotees cast while they chant.
		}

		EventBands: {
			Label: Event bands
			Tooltip: Bands join a Goblin Army, Pirate Invasion, Sandstorm or Slime Rain. They are always hostile and leave when it ends.
		}

		EventGoblins: {
			Label: Goblin skirmishers
			Tooltip: Rocket-booted goblins with hooks and spiky balls join the Goblin Army.
		}

		EventPirates: {
			Label: Pirate boarders
			Tooltip: Gunners and boarders join the Pirate Invasion.
		}

		EventSandstorm: {
			Label: Sandstorm mages
			Tooltip: Desert mages join a Sandstorm.
		}

		EventSlimeRain: {
			Label: Ninja clan
			Tooltip: A ninja clan joins a Slime Rain.
		}

		EventBandCooldownSeconds: {
			Label: Event band cooldown
			Tooltip: Seconds between one event band being beaten and the next one forming while the event lasts.
		}

		EventBandMaxPerEvent: {
			Label: Event bands per event
			Tooltip: Most bands one run of an event sends.
		}
	}
}

Items: {
	Band_ForestDeserters: {
		DisplayName: Deserters' Wanted Poster
		Tooltip:
			'''
			Summons the Forest Deserters, armed with bows and guns
			Fights you and your levies on sight
			Drops a bounty notice when the band is beaten
			'''
	}

