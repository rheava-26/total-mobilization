# Levy — every player-facing string except soldier dialogue (Dialogue/en-US.txt).
# Style: 1-4 short declarative sentences. What it is, reach, the numbers that matter, one special rule.
Mods: {
	Levy: {
		Items: {
			BarracksItem: {
				DisplayName: Barracks
				Tooltip:
					'''
					The hub of a settlement. Town NPCs living within 120 tiles belong to it.
					Right-click it to enlist Regulars, pay wages and raise the militia.
					'''
			}

			ArmoryItem: {
				DisplayName: Armory
				Tooltip:
					'''
					A 1000-slot store with issue rows for weapons, armor, ammo and potions.
					Soldiers of a Barracks within 120 tiles arm themselves from it.
					'''
			}

			LogisticalCenterItem: {
				DisplayName: Logistical Center
				Tooltip:
					'''
					Adds 250 storage slots to the nearest Armory within 40 tiles.
					Centers stack.
					'''
			}

			PatrolBannerItem: {
				DisplayName: Patrol Banner
				Tooltip: Place two to mark a patrol line. Assign Regulars to it from the Barracks.
			}

			WarHorn: {
				DisplayName: War Horn
				Tooltip:
					'''
					Left-click to call up or stand down the nearest settlement's militia.
					Right-click to give orders to your Regulars.
					'''
			}

			CommandRadio: {
				DisplayName: Command Radio
				Tooltip:
					'''
					A field set tuned to every soldier you command.
					Carry it to give orders from the radial to your whole army, anywhere. Click it to open the radial.
					Shift-click the full map to send every levy to that point.
					'''
			}

			GoProItem: {
				DisplayName: GoPro
				Tooltip:
					'''
					A body camera. A levy who carries it can be watched.
					Use it to see through the next GoPro levy. Right-click or Esc to stop.
					'''
			}

			StaticCameraItem: {
				DisplayName: Static Camera
				Tooltip:
					'''
					Place it, then right-click it from anywhere in reach to see its view.
					Mouse wheel zooms out to a wide arena view.
					'''
			}

			MindLinkItem: {
				DisplayName: Mind Link
				Tooltip:
					'''
					Use it to take direct control of the levy nearest your cursor. Your movement and attack drive that levy.
					Right-click to let go. Dying gives you a levy to control until you respawn.
					'''
			}

			FieldManual: {
				DisplayName: Field Manual
				Tooltip:
					'''
					A paged guide to raising, arming and commanding levies.
					Use it to read. It is never used up.
					'''
			}

			GuideToConscription: {
				DisplayName: A Guide to Conscription
				Tooltip: Each town NPC provides 15 manpower instead of 9. Manpower is the reserve the militia draw from as they fall, not how many stand at once. Consumed on use, once per world.
			}

			GuideToDrill: {
				DisplayName: A Guide to Drill
				Tooltip: Militia aim 25% better. Consumed on use, once per world.
			}

			GuideToPlunder: {
				DisplayName: A Guide to Plunder
				Tooltip: Coins hauled to the treasury are worth 50% more. Consumed on use, once per world.
			}

			GuideToFortification: {
				DisplayName: A Guide to Fortification
				Tooltip: Soldiers within 60 tiles of a Barracks gain 4 defense. Consumed on use, once per world.
			}

			GuideToDiscipline: {
				DisplayName: A Guide to Discipline
				Tooltip: Your soldiers aim truer. Shots are 35% tighter. Consumed on use, once per world.
			}

			GuideToFirepower: {
				DisplayName: A Guide to Firepower
				Tooltip:
					'''
					Militia gain 100 health and 80 mana.
					Every Armory gains 2 buff slots.
					Dropped by the Wall of Flesh. Consumed on use, once per world.
					'''
			}

			GuideToHealthcare: {
				DisplayName: A Guide to Healthcare
				Tooltip: Militia gain 150 health. Consumed on use, once per world.
			}

			GuideToTheArcaneArts: {
				DisplayName: A Guide to the Arcane Arts
				Tooltip: Militia gain 60 mana. Consumed on use, once per world.
			}

			GuideToExpertise: {
				DisplayName: A Guide to Expertise
				Tooltip:
					'''
					Every soldier gains 1 accessory slot.
					Dropped by the Lunatic Cultist. Consumed on use, once per world.
					'''
			}

			GuideToEngineering: {
				DisplayName: A Guide to Engineering
				Tooltip:
					'''
					Unlocks combat drones at every Barracks. Needs the Mechanization mod.
					A drone mounts one spare ranged or magic weapon from the Armory and fires it at nearby enemies.
					A destroyed drone returns its weapon. Consumed on use, once per world.
					'''
			}

			LevyRod: {
				DisplayName: Levy Rod
				Tooltip: Plants a levy sentry during the Old One's Army. Calls up {0} levy for {1} Etherian Mana.
			}

			LevyCane: {
				DisplayName: Levy Cane
				Tooltip: Plants a levy sentry during the Old One's Army. Calls up {0} levies for {1} Etherian Mana.
			}

			LevyStaff: {
				DisplayName: Levy Staff
				Tooltip: Plants a levy sentry during the Old One's Army. Calls up {0} levies for {1} Etherian Mana.
			}

			BarracksAle: {
				DisplayName: Barracks Keg
				Tooltip: A keg for the whole army. Increases defense by {2} for your levies within {0} tiles for {1} minutes. They cheer, then stagger: drunk levies have {3}% more aim error.
			}

			BlackStout: {
				DisplayName: Case of Stout
				Tooltip: Twenty-four cans for the whole army. Increases damage by {2}% for your levies within {0} tiles for {1} minutes. They cheer, then stagger: drunk levies have {3}% more aim error.
			}

			MeteorBeacon: {
				DisplayName: Meteor Beacon
				Tooltip: Calls down a meteor when used at night. Needs the Eater of Worlds or Brain of Cthulhu defeated to craft.
			}

			SpicedRum: {
				DisplayName: Rum Cooler
				Tooltip: A cooler for the whole army. Increases critical strike chance by {2}% for your levies within {0} tiles for {1} minutes. They cheer, then stagger: drunk levies have {3}% more aim error.
			}
		}

		Tiles: {
			BarracksTile.MapEntry: Barracks
			ArmoryTile.MapEntry: Armory
			LogisticalCenterTile.MapEntry: Logistical Center
			PatrolBannerTile.MapEntry: Patrol Banner
			StaticCameraTile.MapEntry: Static Camera
		}

		NPCs: {
			SoldierNPC.DisplayName: Soldier
			SummonedUnitNPC.DisplayName: Summoned Unit
			HarnessCharger.DisplayName: Harness Charger
		}

		Projectiles: {
			SoldierThrust.DisplayName: Thrust
			SoldierMinion.DisplayName: Minion
			SoldierWhip.DisplayName: Whip
			SoldierBoomerang.DisplayName: Boomerang
			SoldierYoyo.DisplayName: Yoyo
			SoldierFlail.DisplayName: Flail
			SoldierVampireKnife.DisplayName: Soldier Vampire Knife
			SoldierCrystalLeaf.DisplayName: Soldier Crystal Leaf
			SoldierSpectreHeal.DisplayName: Soldier Spectre Heal Bolt
			SoldierTitaniumShard.DisplayName: Soldier Titanium Shard
			OfficerHealSyringe.DisplayName: Officer Heal Syringe
			SoldierNebulaBooster.DisplayName: Soldier Nebula Booster
			SoldierStardustGuardian.DisplayName: Soldier Stardust Guardian
			SoldierHeal.DisplayName: Soldier Heal
			HarnessBeam.DisplayName: Harness Beam
			LevySentryBanner.DisplayName: Levy Sentry
		}

		Keybinds: {
			FollowMe.DisplayName: Levy: Follow me
			HoldHere.DisplayName: Levy: Hold here
			ReturnToBarracks.DisplayName: Levy: Return to barracks
			HoldFire.DisplayName: Levy: Hold fire / fire at will
			Mobilize.DisplayName: Levy: Mobilize / stand down
			Rally.DisplayName: Levy: Rally
			ArmyStrip.DisplayName: Levy: Army overview
		}

		Configs: {
			WeaponRankMode: {
				Balanced: {
					Label: Balanced
					Tooltip: Weapons rank by sell price. Weapons far behind your world's progress rank lower, and weapons recently added to the Armory rank higher.
				}

				SellPrice: {
					Label: Sell price
					Tooltip: Weapons rank by their sell price.
				}

				SellPricePlusMaterials: {
					Label: Sell price + materials
					Tooltip: Weapons rank by their sell price plus the cost of the materials in their cheapest recipe.
				}

				Damage: {
					Label: Damage
					Tooltip: Weapons rank by damage per second, raised for rarity and price.
				}

				Tooltip: ""
			}

			FearModelSetting: {
				Events: {
					Label: Events
					Tooltip:
						'''
						Levies become afraid when one hit takes 30% of a levy's health, when a levy dies within 40 tiles, and when a boss changes phase.
						Fear drains after 3 seconds without being hit.
						'''
				}

				Proximity: {
					Label: Proximity
					Tooltip: Levies become afraid steadily while a boss is in view, and more so when hit or when a levy dies.
				}

				Tooltip: ""
			}

			LevyConfig: {
				DisplayName: Levy

				Headers: {
					Potions: Potions and mana
					Aim: Aim
					BossBehaviour: Boss behaviour
					LevyCounts: Levy and militia counts
					Slots: Slots
					ArmoryRanking: Armory and ranking
					Hooks: Hooks
					GearUpkeep: Gear upkeep
					Soldiers: Soldiers
					Economy: Economy
					Events: Events
					Interface: Interface
				}

				BossHpScalingPercentPerCp: {
					Label: Boss HP scaling per command point (%)
					Tooltip: Bosses gain this much max and current HP for every command point of soldiers that engage them.
				}

				BossHpScalingCapPercent: {
					Label: Boss HP scaling cap (%)
					Tooltip: The most a boss can gain from engaged soldiers.
				}

				BossesPunishSoldiers: {
					Label: Bosses punish soldiers
					Tooltip: Bosses redirect shots and dashes at soldiers that get close or hurt them.
				}

				BossesTargetSoldiers: {
					Label: Bosses target soldiers
					Tooltip:
						'''
						Bosses you have already defeated in this world chase the nearest soldier like a player.
						The first kill of any boss is always solo. Needs Enemies target soldiers.
						Some boss AIs will not be fully diverted.
						'''
				}

				FearMultiplier: {
					Label: Fear multiplier
					Tooltip: Scales every fear gain during boss fights.
				}

				FearModel: {
					Label: Fear model
					Tooltip:
						'''
						Events: levies fear hits that take 30% of their health, nearby deaths and boss phase changes.
						Proximity: levies fear a boss steadily while it is in view.
						Levies with the Happy! buff, or near a Sunflower, gain fear at half speed.
						'''
				}

				FormationDefense: {
					Label: Formation defense
					Tooltip: A levy takes 2% less damage for each other levy within 15 tiles that is not routed, up to 20%.
				}

				SoldierDamageMultiplier: {
					Label: Soldier damage multiplier
					Tooltip: Scales all soldier damage.
				}

				RenderCap: {
					Label: Soldiers on screen
					Tooltip: Bodies above this number wait in the barracks as reinforcements.
				}

				Tombstones: {
					Label: Tombstones
					Tooltip: Vanilla drops one only for a Hardcore commander.
				}

				EnemiesTargetSoldiers: {
					Label: Enemies target soldiers
					Tooltip: Allowlisted enemies chase the nearest soldier like a player.
				}

				UseVanillaStatPipeline: {
					Label: Use vanilla stat pipeline
					Tooltip: Soldiers get armor set and accessory stats through the game's own equipment code. Turn off if another mod misbehaves.
				}

				AutoFeedCrystals: {
					Label: Soldiers use growth crystals from the Armory
					Tooltip: Soldiers draw Life Crystals, Life Fruit and Mana Crystals from their Armory's storage, one at a time, until they reach their grade limit.
				}

				ArmoryTurnsStarsIntoMana: {
					Label: Levies use Fallen Stars as Mana Crystals
					Tooltip: Fallen Stars in an Armory's storage become Mana Crystals for its magic levies at the crafting cost, worst-supplied first. Stars are kept while any weapon there or in a levy's hands fires them.
				}

				RealWeaponShoot: {
					Label: Real weapon effects
					Tooltip: Soldiers fire through the game's own shooting code, so special weapons keep their effects. Turn off to use the simpler fallback.
				}

				ClassMatchIssue: {
					Label: Fixed-class companies
					Tooltip: Off, soldiers take the strongest weapon they can use whatever its type, and their armor follows it. On, a soldier's armor decides the weapon class he draws and his upgrades stay within that class.
				}

				WeaponRanking: {
					Label: Weapon ranking
					Tooltip: Levies draw the highest-ranked weapon their class can use. This sets what a weapon is ranked by.
				}

				SkipArmoredWeapons: {
					Label: Skip weapons that barely hurt armored enemies
					Tooltip: A weapon whose hits do almost nothing to the enemies at your world's progress ranks below every weapon that does real damage. Applies to the price rankings.
				}

				AimAccuracy: {
					Label: Levy aim accuracy
					Tooltip: Higher values make levies aim better, lower values worse. This strongly affects how strong levies are.
				}

				AutoUpgradeWeapons: {
					Label: Soldiers upgrade their gear
					Tooltip: Soldiers swap to a clearly better weapon or armor set when one is stocked in their Armory, and put the old one back. Soldiers with Lock Loadout on are skipped.
				}

				SoldiersTriggerPressurePlates: {
					Label: Soldiers trigger pressure plates
					Tooltip: Off by default.
				}

				SoldierEffectsAtSoldier: {
					Label: Weapon effects start at the soldier
					Tooltip: Weapon effects a levy triggers start at the levy.
				}

				RealGearUpkeep: {
					Label: Worn gear runs every tick
					Tooltip: A levy's accessories and armor run their per-tick effects, as a player's do.
				}

				SoldiersUseHooks: {
					Label: Levies use grappling hooks
					Tooltip: Levies carry the best grappling hook in the armory. They swing across gaps and climb cliffs with it.
				}

				SoldiersTakeFallDamage: {
					Label: Levies take fall damage
					Tooltip: Levies take fall damage by the player's rules. Wings, a Lucky Horseshoe and water landings spare them.
				}

				ExtraTargetingAiStyles: {
					Label: Extra targeting AI styles
					Tooltip: Additional NPC aiStyle numbers that may target soldiers.
				}

				WageMultiplier: {
					Label: Wage multiplier
					Tooltip: Scales every wage and fee.
				}

				WageMutiny: {
					Label: Wage mutiny
					Tooltip: Soldiers whose wage the treasury cannot pay revolt at once. They refuse every order, rob town NPCs, attack you and rob your pockets and banks until they have taken their back pay or the treasury pays it. Off by default.
				}

				AutoMusterDefault: {
					Label: Auto-muster by default
					Tooltip: New barracks call the militia when an invasion or Blood Moon starts.
				}

				OldOnesArmyUsesLevySentries: {
					Label: Old One's Army uses levy sentries
					Tooltip: Regular levies stand down during the Old One's Army. Levy sentries call them up for Etherian Mana.
				}

				MilitiaFieldCap: {
					Label: Militia on the field at once
					Tooltip: How many militia a town fields simultaneously. Manpower is the deeper reserve they draw from as they fall; this keeps the active crowd small.
				}

				LeviesAtStart: {
					Label: Levies at the start
					Tooltip: Levies you can field in a new world, before any boss is beaten. Recommended 6 to 20.
				}

				LeviesByEndOfPreHardmode: {
					Label: Levies by the Wall of Flesh
					Tooltip: Levies you can field once every pre-hardmode boss is beaten. Recommended 12 to 30. Each boss beaten adds its share. Modded bosses count by their Boss Checklist position.
				}

				LeviesByEndOfHardmode: {
					Label: Levies by Moon Lord
					Tooltip: Levies you can field once Moon Lord and every boss before him is beaten. Recommended 28 to 60. The bosses in between are worth points automatically.
				}

				LeviesByEndOfPostMoonLord: {
					Label: Levies by the end of post-Moon Lord
					Tooltip: Levies you can field once the final boss is beaten. Recommended 40 to 90. Every boss after Moon Lord adds its share of the last stretch.
				}

				MaxLevies: {
					Label: Maximum levies
					Tooltip: The most levies you can ever field, whatever the other numbers say.
				}

				MilestoneRewards: {
					Label: Boss milestones
					Tooltip: A boss you beat grants every levy extra accessory slots and the world extra levies. Each entry shows what it grants. All start switched off.
				}

				LevyAccessorySlots: {
					Label: Levy accessory slots
					Tooltip: Accessory slots a Levy opens. Every levy has at least 2: one for the best mobility accessory, one for the best other accessory. At most 6.
				}

				ManAtArmsAccessorySlots: {
					Label: Man-at-Arms accessory slots
					Tooltip: Accessory slots a Man-at-Arms opens. Every levy has at least 2. At most 6.
				}

				ChampionAccessorySlots: {
					Label: Champion accessory slots
					Tooltip: Accessory slots a Champion opens. Every levy has at least 2. At most 6.
				}

				ExpertiseGuideSlots: {
					Label: A Guide to Expertise slots
					Tooltip: Accessory slots every levy gains when the Guide to Expertise is read. Boss milestones add more.
				}

				NurseHealsSoldiers: {
					Label: Nurse heals soldiers
					Tooltip: Soldiers within 4 tiles of the Nurse are healed at her price from the treasury.
				}

				Spoils: {
					Label: Soldiers loot coins
					Tooltip: Coins dropped near a soldier go into their barracks treasury. Coins near you are left alone.
				}

				MagicStorageSupply: {
					Label: Armories draw from Magic Storage
					Tooltip: An armory within 50 tiles of a Storage Heart, Storage Access or Remote Access arms soldiers from that network once its own shelves and pylon-linked armories run dry. Does nothing without Magic Storage.
				}

				LogisticsReachesPylons: {
					Label: Logistics reaches shopkeepers through pylons
					Tooltip: An armory within 60 tiles of a working pylon also trades with shopkeepers housed near any other working pylon. Buying, standing buys and selling all use them.
				}

				Nameplates: {
					Label: Nameplates
					Tooltip: Name, grade and HP over each soldier. Hidden when more than 20 are on screen.
				}

				MilitiaDeathMessages: {
					Label: Militia death messages
					Tooltip: Count posts one line when the event ends.
				}

				RegularDeathMessages: {
					Label: Regular death messages
					Tooltip: A chat line when a Regular dies.
				}

				DoNotAttackNpcNames: {
					Label: Do Not Attack Npc Names
					Tooltip: ""
				}
			}

			MilestoneReward: {
				Boss: {
					Label: Boss
					Tooltip: A vanilla boss id such as WallOfFlesh, Plantera or MoonLord, or a modded boss's exact name.
				}

				AccessorySlots: {
					Label: Accessory slots
					Tooltip: Accessory slots every levy gains.
				}

				Levies: {
					Label: Levies
					Tooltip: Levies added to the world's levy count, on top of the maximum.
				}

				Enabled: {
					Label: On
					Tooltip: ""
				}

				Tooltip: ""
			}

			TombstoneMode: {
				Tooltip: ""

