# Officer buff strings. Keys are relative to Mods.Levy.Buffs. (The Marked buff's strings live in en-US.hjson.)
MoraleBuff: {
	DisplayName: Morale
	Description: Increases damage by 12%, defense by 10 and critical strike chance by 10%
}

BardEmpowermentBuff: {
	DisplayName: Empowered
	Description: Gains the stat bonuses of a bard's instrument
}

DryadsBlessingBuff: {
	DisplayName: Dryad's Blessing
	Description: Increases defense by 8 and life regeneration. Reflects 50% of contact damage
}

VenomBuff: {
	DisplayName: Venom
	Description: Losing life, ignoring defense
}

PaintedBuff: {
	DisplayName: Paint-Soaked
	Description: Decreases defense by 20 and damage by 25%
}

AleBuff: {
	DisplayName: Ale
	Description: Increases defense by 8. Increases aim error by 60%
}

StoutBuff: {
	DisplayName: Stout
	Description: Increases damage by 15%. Increases aim error by 60%
}

RumBuff: {
	DisplayName: Rum
	Description: Increases critical strike chance by 10%. Increases aim error by 60%
}
