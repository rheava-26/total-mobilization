# Keys here are relative to Mods.Levy.Configs (progression assistance config).
LevyProgressionConfig: {
	DisplayName: Levy: Progression assistance

	Headers: {
		Note: Levy is designed around vanilla progression. These options only ease hard-to-get items. Recipes:
		DropRates: Drop rates
		Chlorophyte: Chlorophyte growth
		Items: Boss weapons, shimmer and crates
		ArmorCosts: Armor costs
		ArmsDealer: Arms Dealer
		ArmyLoot: Army loot
		DungeonSpirits: Dungeon Spirits
		EventsAndOfficers: Events and officers
		ChlorophyteSources: Chlorophyte sources
		Lunar: Luminite and Lunar Fragments
	}

	LifeCrystalRecipe: {
		Label: Life Crystal recipe
		Tooltip: Craft a Life Crystal from 5 Lesser Healing Potions and 1 Ruby at an Alchemy Table. Needs a reload
	}

	LifeFruitRecipe: {
		Label: Life Fruit recipe
		Tooltip: Craft a Life Fruit from a Life Crystal, 3 Chlorophyte Bars and 5 Jungle Spores at a Mythril Anvil after any mechanical boss. Needs a reload
	}

	FallenStarRecipe: {
		Label: Fallen Star recipe
		Tooltip: Craft a Fallen Star from 3 Meteorite Bars at an Anvil after the Eater of Worlds or Brain of Cthulhu. Needs a reload
	}

	FallenStarsPerManaCrystal: {
		Label: Fallen Stars per Mana Crystal
		Tooltip: Fallen Stars one Mana Crystal costs. 5 is normal. Needs a reload
	}

	ChlorophyteOrePerBar: {
		Label: Chlorophyte Ore per bar
		Tooltip: Chlorophyte Ore for one Chlorophyte Bar. 5 is normal. Needs a reload
	}

	ChlorophyteOreRecipe: {
		Label: Chlorophyte Ore recipe
		Tooltip: Craft Chlorophyte Ore from 2 Mud Blocks and 2 Jungle Spores at an Adamantite Forge in Hardmode. Needs a reload
	}

	AmmoRecipeYieldMultiplier: {
		Label: Ammo recipe yield
		Tooltip: Multiplies the arrows, bullets, darts and rockets each ammo recipe makes. Needs a reload
	}

	EctoplasmDropMultiplier: {
		Label: Ectoplasm drop rate
		Tooltip: Multiplies Ectoplasm drops. Needs a reload
	}

	SoulDropMultiplier: {
		Label: Soul drop rate
		Tooltip: Multiplies drops of Souls of Light, Night and Flight. Needs a reload
	}

	MobDropMultiplier: {
		Label: Monster drop rate
		Tooltip: Multiplies every drop of non-boss monsters. Needs a reload
	}

	ChlorophyteGrowthMultiplier: {
		Label: Chlorophyte growth
		Tooltip: Extra Chlorophyte spawn and spread attempts per growth update. 1 is normal
	}

	ChlorophyteChunkScale: {
		Label: Chlorophyte chunk size
		Tooltip: Scales how much Chlorophyte may grow in one area. 1 is normal
	}

	OnceOnlyBossWeaponRepeatPercent: {
		Label: Repeat boss weapon drop
		Tooltip: Chance per kill for Plantera or her Treasure Bag to drop another Grenade Launcher. Needs a reload
	}

	ShimmerDesertShards: {
		Label: Shimmer shard route
		Tooltip: Shimmer turns Forbidden Fragments into Dark Shards, Dark Shards into Light Shards and Light Shards into Forbidden Fragments. Needs a reload
	}

	EarlyHardmodeCrateOreMultiplier: {
		Label: Early Hardmode crate ore
		Tooltip: Multiplies the Cobalt, Palladium, Mythril and Orichalcum ore in crates. Needs a reload
	}

	ChlorophyteArmorCostPercent: {
		Label: Chlorophyte armor cost
		Tooltip: Percent of the normal ingredient cost of Chlorophyte armor. Needs a reload.
	}

	HallowedArmorCostPercent: {
		Label: Hallowed armor cost
		Tooltip: Percent of the normal ingredient cost of Hallowed armor. Needs a reload.
	}

	SpiderArmorCostPercent: {
		Label: Spider armor cost
		Tooltip: Percent of the normal ingredient cost of Spider armor. Needs a reload.
	}

	LevyArmorCostPercent: {
		Label: Levy armor sets cost
		Tooltip: Percent of the normal ingredient cost of every armor set, except Spectre, Shroomite and Spooky. Needs a reload
	}

	ArmsDealerBulkAmmo: {
		Label: Arms Dealer bulk ammo
		Tooltip: The Arms Dealer sells any ammo you have crafted or picked up enough of, up to 12 types
	}

	BulkAmmoUnlockAmount: {
		Label: Bulk ammo unlock amount
		Tooltip: Rounds of one ammo type you need before the Arms Dealer sells it
	}

	BulkAmmoPricePercent: {
		Label: Bulk ammo price
		Tooltip: Percent of the item's normal shop price.
	}

	ArmyLootPercentPerCp: {
		Label: Army loot bonus per command point
		Tooltip: Boss drops and Treasure Bags give this percent more ore, bars and materials per command point your levies hold. 0 is off
	}

	ArmyLootRareChance: {
		Label: Army bonus on rare drops
		Tooltip: The same percent raises the chance of rare boss drops.
	}

	OrbLootScaling: {
		Label: Extra orb and heart loot
		Tooltip: Smashing a Shadow Orb or Crimson Heart rolls extra drops from its own loot
	}

	LeviesPerExtraOrbRoll: {
		Label: Levies per extra orb roll
		Tooltip: Every this many levies on duty add one roll to each orb or heart smash
	}

	DungeonSpiritMultiplier: {
		Label: Dungeon Spirit spawn rate
		Tooltip: Multiplies how often a dying dungeon monster summons a Dungeon Spirit after Plantera
	}

	DungeonSpiritPercentPerCp: {
		Label: Dungeon Spirit bonus per command point
		Tooltip: Raises the spawn rate by this percent for each command point your levies hold.
	}

	EventSpawnBoost: {
		Label: Events spawn more with an army
		Tooltip: Events spawn faster and in larger numbers as your army grows. Off leaves the vanilla rate
	}

	EventInvasionBoost: {
		Label: Bigger invasions with an army
		Tooltip: Invasions start several times their vanilla size, more with a larger army. Off leaves the vanilla size
	}

	MerchantFenceCoins: {
		Label: Merchant fences kills
		Tooltip: A Merchant on the field pays the treasury the coin value of every enemy that dies within 30 tiles of him
	}

	TaxCollectorBounty: {
		Label: Tax Collector bounty
		Tooltip: A Tax Collector on the field pays the treasury a bounty for every marked enemy that dies near him
	}

	ExtractinatorChlorophyte: {
		Label: Extractinator Chlorophyte
		Tooltip: Mud Blocks in an Extractinator sometimes yield Chlorophyte Ore after any mechanical boss. Needs a reload
	}

	ExtractinatorChlorophytePercent: {
		Label: Extractinator Chlorophyte chance
		Tooltip: Percent of Mud Blocks that yield 1 to 3 Chlorophyte Ore.
	}

	JungleChlorophyteDrop: {
		Label: Jungle monsters drop Chlorophyte
		Tooltip: After Plantera, monsters killed in the Jungle can drop Chlorophyte Ore.
	}

	JungleChlorophyteChance: {
		Label: Jungle Chlorophyte chance
		Tooltip: Percent chance per kill to drop 1 to 3 Chlorophyte Ore.
	}

	EventChlorophyteDrop: {
		Label: Event monsters drop Chlorophyte
		Tooltip: Pumpkin Moon, Frost Moon and Lunar Event monsters can drop Chlorophyte Ore.
	}

	EventChlorophyteChance: {
		Label: Event Chlorophyte chance
		Tooltip: Percent chance per kill to drop 1 to 3 Chlorophyte Ore.
	}

	LuminiteDropMultiplier: {
		Label: Luminite drop
		Tooltip: Multiplies the Luminite the Moon Lord and his Treasure Bag drop.
	}

	LunarFragmentDropMultiplier: {
		Label: Lunar Fragment drop
		Tooltip: Multiplies the fragments the Lunar Pillars drop.
	}
}
