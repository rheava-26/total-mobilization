# Mechanization — player-facing strings. Keys are relative to Mods.Mechanization (prefix comes from the file name).
# Style: 1-4 short declarative sentences. What it is, reach, the numbers that matter, one special rule.
Items: {
	ArmoryRelayItem: {
		DisplayName: Armory Relay
		Tooltip:
			'''
			Links to the nearest Armory within 1000 tiles or your pylon network
			Turrets and drones within 25 tiles draw from that Armory
			'''
	}

	DroneItem: {
		DisplayName: Combat Drone
		Tooltip:
			'''
			Places a combat drone at the cursor
			Patrols 36 tiles either side of that spot
			Mounts the best spare ranged weapon from an Armory within 240 tiles
			Fires a plain bullet with no weapon, reach 32 tiles
			Right click the drone to pack it up
			'''
	}

	TurretItem: {
		DisplayName: Automatic Turret
		Tooltip:
			'''
			Shoots hostiles within reach of its weapon
			Mounts the best spare ranged weapon from an Armory within 240 tiles
			Fires a plain bullet with no weapon, reach 32 tiles
			'''
	}
}

Tiles.ArmoryRelayTile.MapEntry: Armory Relay

NPCs: {
	TurretNPC.DisplayName: Automatic Turret
	DroneNPC.DisplayName: Combat Drone
}

Keybinds.RecallDrones.DisplayName: Mechanization: Recall or launch drones

Configs: {
	MechConfig: {
		DisplayName: Mechanization

		FireOnUnbeatenBosses: {
			Label: Drones and turrets fire on bosses you haven't beaten
			Tooltip: Off, they hold fire on a boss until you have defeated it once. Its minions are always fair game.
		}
	}
}

UI: {
	RelayLinked: Armory at {0}, {1}. {2} tiles away. Serves turrets and drones within {3} tiles.
	RelayUnlinked: No armory linked. Armories within {0} tiles: {1}. Pylons within {2} tiles: {3}. Armories on a pylon network: {4}.
	RelayNoEntity: This relay has no tile entity. Pick it up and place it again.
	TurretDismantle: Dismantle
	TurretChatMounted: Weapon: {0}. Reach {2} tiles. Armories: {1}.
	TurretChatNoWeapon: No weapon. Plain bullet, reach {0} tiles. No spare ranged weapon.
	TurretChatNoArmory: No weapon. Plain bullet, reach {0} tiles. No armory in reach.
	TurretNoRoom: No room for a turret there.
	HintPlaceLinked: Armories: {0}
	HintPlaceUnlinked: No armory in reach.
	HintTurretMounted: "{0}. Reach {2} tiles. Armories: {1}"
	HintTurretNoWeapon: No weapon. Plain bullet, reach {0} tiles.
	HintTurretNoArmory: No armory. Plain bullet, reach {0} tiles.
	DroneRecall: Recall
	DroneLaunch: Launch
	DroneRecallAll: Recall all
	DroneLaunchAll: Launch all
	DroneChatLoiter: Patrolling. Weapon: {0}. Battery {1}%.
	DroneChatRefuel: Returning to the armory. Battery {0}%.
	DroneChatCharging: Landed. Weapon: {0}. Battery {1}%.
	DroneChatRecall: Returning to the armory.
	DroneChatParked: Landed. No weapon. Battery {0}%.
	DroneRecalling: Drones recalled: {0}.
	DroneLaunching: Drones launched: {0}.
	DroneNoSpare: No spare weapon in the armory.
	DroneKeyNoBarracks: No Barracks within reach.
	DroneNone: This Barracks has no drones.
	DronePackUp: Pack up
	DroneNoRoom: No room for a drone there.
	DroneNoSlots: No drone placed. {0} free NPC slots, {1} needed.
	DroneGarrisonNoSlots: No drone launched. {0} free NPC slots, {1} needed.
	DroneGarrisonNoSpare: No drone launched. The army keeps the best {0} ranged weapons in the armory.
	TurretNoSlots: No turret placed. No free NPC slot.
	DroneFieldMounted: Weapon: {0}. Battery {1}%. Armories: {2}.
